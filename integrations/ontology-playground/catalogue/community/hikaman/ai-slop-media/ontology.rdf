<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xml:base="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-media/" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:ont="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-media/">
<owl:Ontology rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-media/"><rdfs:label>AI Slop by Medium</rdfs:label><rdfs:comment>AI Slop types organized by text, image, video, audio, music, code, and multimodal form.</rdfs:comment></owl:Ontology>
<owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#AISlop"><rdfs:label>AI Slop</rdfs:label><rdfs:comment>A slop phenomenon in which generative AI is a primary production source and human care, verification, or intentional curation is insufficient.</rdfs:comment><ont:icon>🤖</ont:icon><ont:color>#0078D4</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-media/aiSlop_id"><rdfs:label>aiSlopId</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#AISlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#TextSlop"><rdfs:label>Text Slop</rdfs:label><rdfs:comment>Low-care AI-generated text with weak information density, originality, verification, relevance, or recipient utility.</rdfs:comment><ont:icon>📝</ont:icon><ont:color>#107C10</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-media/textSlop_id"><rdfs:label>textSlopId</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#TextSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#ImageSlop"><rdfs:label>Image Slop</rdfs:label><rdfs:comment>Low-care AI-generated imagery with weak purpose, misleading context, repetitive templates, or synthetic artifacts.</rdfs:comment><ont:icon>🖼️</ont:icon><ont:color>#D83B01</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-media/imageSlop_id"><rdfs:label>imageSlopId</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#ImageSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#VideoSlop"><rdfs:label>Video Slop</rdfs:label><rdfs:comment>Low-care AI-generated video optimized for volume, attention, or imitation rather than coherent and verified communication.</rdfs:comment><ont:icon>🎬</ont:icon><ont:color>#5C2D91</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-media/videoSlop_id"><rdfs:label>videoSlopId</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#VideoSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#AudioSlop"><rdfs:label>Audio Slop</rdfs:label><rdfs:comment>Low-care AI-generated speech or sound with weak provenance, authenticity, usefulness, or intentional production.</rdfs:comment><ont:icon>🎙️</ont:icon><ont:color>#008272</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-media/audioSlop_id"><rdfs:label>audioSlopId</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#AudioSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#MusicSlop"><rdfs:label>Music Slop</rdfs:label><rdfs:comment>Mass-produced or deceptive AI-generated music that dilutes discovery, royalties, or artist identity.</rdfs:comment><ont:icon>🎵</ont:icon><ont:color>#00A9E0</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-media/musicSlop_id"><rdfs:label>musicSlopId</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#MusicSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#CodeSlop"><rdfs:label>Code Slop</rdfs:label><rdfs:comment>AI-generated code, issues, reviews, or security reports that appear plausible but create correctness, security, or review burden.</rdfs:comment><ont:icon>💻</ont:icon><ont:color>#FFB900</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-media/codeSlop_id"><rdfs:label>codeSlopId</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#CodeSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#MultimodalSlop"><rdfs:label>Multimodal Slop</rdfs:label><rdfs:comment>A slop artifact combining multiple generated media such as text, image, audio, video, or code.</rdfs:comment><ont:icon>🧩</ont:icon><ont:color>#E81123</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-media/multimodalSlop_id"><rdfs:label>multimodalSlopId</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#MultimodalSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-media/r1"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#TextSlop"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#AISlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>textSlop</ont:fromEntityId><ont:toEntityId>aiSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-media/r2"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#ImageSlop"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#AISlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>imageSlop</ont:fromEntityId><ont:toEntityId>aiSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-media/r3"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#VideoSlop"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#AISlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>videoSlop</ont:fromEntityId><ont:toEntityId>aiSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-media/r4"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#AudioSlop"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#AISlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>audioSlop</ont:fromEntityId><ont:toEntityId>aiSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-media/r5"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#MusicSlop"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#AudioSlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>musicSlop</ont:fromEntityId><ont:toEntityId>audioSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-media/r6"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#CodeSlop"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#AISlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>codeSlop</ont:fromEntityId><ont:toEntityId>aiSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-media/r7"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#MultimodalSlop"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#AISlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>multimodalSlop</ont:fromEntityId><ont:toEntityId>aiSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-media/r8"><rdfs:label>combines</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#MultimodalSlop"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#TextSlop"/><ont:cardinality>many-to-many</ont:cardinality><ont:fromEntityId>multimodalSlop</ont:fromEntityId><ont:toEntityId>textSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-media/r9"><rdfs:label>combines</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#MultimodalSlop"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#ImageSlop"/><ont:cardinality>many-to-many</ont:cardinality><ont:fromEntityId>multimodalSlop</ont:fromEntityId><ont:toEntityId>imageSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-media/r10"><rdfs:label>combines</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#MultimodalSlop"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#AudioSlop"/><ont:cardinality>many-to-many</ont:cardinality><ont:fromEntityId>multimodalSlop</ont:fromEntityId><ont:toEntityId>audioSlop</ont:toEntityId></owl:ObjectProperty>
</rdf:RDF>
