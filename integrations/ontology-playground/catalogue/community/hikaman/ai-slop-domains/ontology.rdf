<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xml:base="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-domains/" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:ont="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-domains/">
<owl:Ontology rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-domains/"><rdfs:label>AI Slop by Domain</rdfs:label><rdfs:comment>Domain-specific AI Slop covering academic, legal, workplace, review, security, education, and political contexts.</rdfs:comment></owl:Ontology>
<owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#AISlop"><rdfs:label>AI Slop</rdfs:label><rdfs:comment>A slop phenomenon in which generative AI is a primary production source and human care, verification, or intentional curation is insufficient.</rdfs:comment><ont:icon>🤖</ont:icon><ont:color>#0078D4</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-domains/aISlop_id"><rdfs:label>aISlopId</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#AISlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#AcademicSlop"><rdfs:label>Academic Slop</rdfs:label><rdfs:comment>AI-generated scholarly content with superficial analysis, fabricated citations, weak originality, or poor engagement with evidence.</rdfs:comment><ont:icon>🎓</ont:icon><ont:color>#107C10</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-domains/academicSlop_id"><rdfs:label>academicSlopId</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#AcademicSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#LegalSlop"><rdfs:label>Legal Slop</rdfs:label><rdfs:comment>AI-generated legal content with unverified authorities, fabricated precedents, or misleading legal analysis.</rdfs:comment><ont:icon>⚖️</ont:icon><ont:color>#D83B01</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-domains/legalSlop_id"><rdfs:label>legalSlopId</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#LegalSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#AIWorkslop"><rdfs:label>AI Workslop</rdfs:label><rdfs:comment>AI-generated workplace content that looks polished or complete but lacks context, substance, or usefulness and shifts real work to recipients.</rdfs:comment><ont:icon>🤖</ont:icon><ont:color>#5C2D91</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-domains/aIWorkslop_id"><rdfs:label>aIWorkslopId</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#AIWorkslop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#PeerReviewSlop"><rdfs:label>Peer Review Slop</rdfs:label><rdfs:comment>AI-generated peer review that performs evaluation without substantive engagement with the manuscript, evidence, or contribution.</rdfs:comment><ont:icon>📋</ont:icon><ont:color>#008272</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-domains/peerReviewSlop_id"><rdfs:label>peerReviewSlopId</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#PeerReviewSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#SecurityReportSlop"><rdfs:label>Security Report Slop</rdfs:label><rdfs:comment>Plausible-sounding AI-generated vulnerability reporting that lacks reproducibility, validity, or actionable technical evidence.</rdfs:comment><ont:icon>🔐</ont:icon><ont:color>#00A9E0</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-domains/securityReportSlop_id"><rdfs:label>securityReportSlopId</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#SecurityReportSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#EducationalSlop"><rdfs:label>Educational Slop</rdfs:label><rdfs:comment>Low-care AI-generated educational material that competes with authoritative instruction while failing factual or instructional quality requirements.</rdfs:comment><ont:icon>📚</ont:icon><ont:color>#FFB900</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-domains/educationalSlop_id"><rdfs:label>educationalSlopId</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#EducationalSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#PoliticalSlop"><rdfs:label>Political Slop</rdfs:label><rdfs:comment>AI-generated political content that saturates attention, imitates authority, distorts context, or manipulates civic perception.</rdfs:comment><ont:icon>🗳️</ont:icon><ont:color>#E81123</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-domains/politicalSlop_id"><rdfs:label>politicalSlopId</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#PoliticalSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-domains/r1"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#AcademicSlop"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#AISlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>academicSlop</ont:fromEntityId><ont:toEntityId>aISlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-domains/r2"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#LegalSlop"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#AISlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>legalSlop</ont:fromEntityId><ont:toEntityId>aISlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-domains/r3"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#AIWorkslop"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#AISlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>aIWorkslop</ont:fromEntityId><ont:toEntityId>aISlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-domains/r4"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#PeerReviewSlop"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#AcademicSlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>peerReviewSlop</ont:fromEntityId><ont:toEntityId>academicSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-domains/r5"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#SecurityReportSlop"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#AISlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>securityReportSlop</ont:fromEntityId><ont:toEntityId>aISlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-domains/r6"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#EducationalSlop"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#AISlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>educationalSlop</ont:fromEntityId><ont:toEntityId>aISlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-domains/r7"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#PoliticalSlop"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#AISlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>politicalSlop</ont:fromEntityId><ont:toEntityId>aISlop</ont:toEntityId></owl:ObjectProperty>
</rdf:RDF>
