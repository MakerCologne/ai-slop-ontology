  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology#hasIdentifier">
    <rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#HumanWorkSlop"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <isIdentifier>true</isIdentifier>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology#hasIdentifier">
    <rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#AIWorkslop"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <isIdentifier>true</isIdentifier>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology#hasIdentifier">
    <rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#JargonSlop"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <isIdentifier>true</isIdentifier>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology#hasIdentifier">
    <rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#MeetingSlop"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <isIdentifier>true</isIdentifier>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology#hasIdentifier">
    <rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#DocumentationSlop"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <isIdentifier>true</isIdentifier>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology#hasIdentifier">
    <rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#ReviewSlop"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <isIdentifier>true</isIdentifier>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology#specializes">
    <rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#HumanWorkSlop"/>
