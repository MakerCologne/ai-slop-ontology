<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:ont="urn:ontology-playground:">
<owl:Ontology rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/work-slop/"><rdfs:label>Work Slop</rdfs:label><rdfs:comment>Overview of technology-neutral workplace slop and its AI, human-authored, and management forms.</rdfs:comment></owl:Ontology>
<owl:Class rdf:about="#WorkSlop"><rdfs:label>Work Slop</rdfs:label><rdfs:comment>Work outputs or activities that transfer verification, interpretation, coordination, or rework costs to recipients.</rdfs:comment><ont:icon>💼</ont:icon><ont:color>#0078D4</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="#p1"><rdfs:label>workSlopId</rdfs:label><rdfs:domain rdf:resource="#WorkSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="#AIWorkslop"><rdfs:label>AI Workslop</rdfs:label><rdfs:comment>AI-created workplace output that appears complete but shifts substantial real work to recipients.</rdfs:comment><ont:icon>🤖</ont:icon><ont:color>#107C10</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="#p2"><rdfs:label>aiWorkslopId</rdfs:label><rdfs:domain rdf:resource="#AIWorkslop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="#HumanAuthoredWorkSlop"><rdfs:label>Human-authored Work Slop</rdfs:label><rdfs:comment>Human-authored work output with weak goal contribution and concealed downstream burden.</rdfs:comment><ont:icon>🧑‍💼</ont:icon><ont:color>#D83B01</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="#p3"><rdfs:label>humanAuthoredWorkSlopId</rdfs:label><rdfs:domain rdf:resource="#HumanAuthoredWorkSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="#ManagementSlop"><rdfs:label>Management Slop</rdfs:label><rdfs:comment>Management artifacts or rituals whose apparent legitimacy exceeds their contribution to organizational goals.</rdfs:comment><ont:icon>🧭</ont:icon><ont:color>#5C2D91</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="#p4"><rdfs:label>managementSlopId</rdfs:label><rdfs:domain rdf:resource="#ManagementSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:ObjectProperty rdf:about="#r1"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="#AIWorkslop"/><rdfs:range rdf:resource="#WorkSlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>aIWorkslop</ont:fromEntityId><ont:toEntityId>workSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="#r2"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="#HumanAuthoredWorkSlop"/><rdfs:range rdf:resource="#WorkSlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>humanAuthoredWorkSlop</ont:fromEntityId><ont:toEntityId>workSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="#r3"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="#ManagementSlop"/><rdfs:range rdf:resource="#WorkSlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>managementSlop</ont:fromEntityId><ont:toEntityId>workSlop</ont:toEntityId></owl:ObjectProperty>
</rdf:RDF>
