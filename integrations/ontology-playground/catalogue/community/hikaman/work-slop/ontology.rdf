    <rdfs:label xml:lang="en">Jargon Slop</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#MeetingSlop">
    <rdfs:label xml:lang="en">Meeting Slop</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#DocumentationSlop">
