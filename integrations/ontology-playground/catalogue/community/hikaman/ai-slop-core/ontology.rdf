<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns="https://github.com/hikaman/ai-slop-ontology#"
         xml:base="https://github.com/hikaman/ai-slop-ontology">
  <owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#ContentItem">
    <rdfs:label xml:lang="en">Content Item</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#SyntheticContent">
    <rdfs:label xml:lang="en">Synthetic Content</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#GenericSlop">
    <rdfs:label xml:lang="en">Generic Slop</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#PseudoInsightSlop">
    <rdfs:label xml:lang="en">Pseudo Insight Slop</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#FakeAuthoritySlop">
    <rdfs:label xml:lang="en">Fake Authority Slop</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#SlopPhenomenon">
    <rdfs:label xml:lang="en">Slop Phenomenon</rdfs:label>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology#hasIdentifier">
    <rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#ContentItem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <isIdentifier>true</isIdentifier>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology#hasIdentifier">
    <rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#SyntheticContent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <isIdentifier>true</isIdentifier>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology#hasIdentifier">
    <rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#GenericSlop"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <isIdentifier>true</isIdentifier>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology#hasIdentifier">
    <rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#PseudoInsightSlop"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <isIdentifier>true</isIdentifier>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology#hasIdentifier">
    <rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#FakeAuthoritySlop"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <isIdentifier>true</isIdentifier>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology#hasIdentifier">
    <rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#SlopPhenomenon"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <isIdentifier>true</isIdentifier>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology#hasPhenomenon">
    <rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#ContentItem"/>
    <rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#SlopPhenomenon"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology#exhibits">
    <rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#SyntheticContent"/>
    <rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#GenericSlop"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology#exhibitsPseudoInsight">
    <rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#SyntheticContent"/>
    <rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#PseudoInsightSlop"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology#citesFakeAuthority">
    <rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#SyntheticContent"/>
    <rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#FakeAuthoritySlop"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology#generates">
    <rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#SyntheticContent"/>
    <rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#ContentItem"/>
  </owl:ObjectProperty>
</rdf:RDF>
