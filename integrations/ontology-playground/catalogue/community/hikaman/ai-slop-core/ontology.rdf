<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xml:base="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-core/" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:ont="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-core/">
<owl:Ontology rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-core/"><rdfs:label>AI Slop Core</rdfs:label><rdfs:comment>Core concepts connecting AI Slop, Human Slop, Work Slop, SEO Slop, evidence, harms, and mitigation.</rdfs:comment></owl:Ontology>
<owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#SlopPhenomenon"><rdfs:label>Slop Phenomenon</rdfs:label><rdfs:comment>A low-care artifact, activity, process, or distribution pattern whose apparent completeness or scale exceeds its useful contribution.</rdfs:comment><ont:icon>🧪</ont:icon><ont:color>#0078D4</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-core/slopPhenomenon_id"><rdfs:label>slopPhenomenonId</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#SlopPhenomenon"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#AISlop"><rdfs:label>AI Slop</rdfs:label><rdfs:comment>A slop phenomenon in which generative AI is a primary production source and human care, verification, or intentional curation is insufficient.</rdfs:comment><ont:icon>🤖</ont:icon><ont:color>#107C10</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-core/aISlop_id"><rdfs:label>aISlopId</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#AISlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#HumanSlop"><rdfs:label>Human Slop</rdfs:label><rdfs:comment>A proposed grouping for slop-like outputs or processes produced or maintained primarily by people rather than generative systems.</rdfs:comment><ont:icon>🧑</ont:icon><ont:color>#D83B01</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-core/humanSlop_id"><rdfs:label>humanSlopId</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#HumanSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#WorkSlop"><rdfs:label>Work Slop</rdfs:label><rdfs:comment>A technology-neutral family of workplace artifacts or activities that shift interpretation, verification, coordination, or rework costs to recipients.</rdfs:comment><ont:icon>💼</ont:icon><ont:color>#5C2D91</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-core/workSlop_id"><rdfs:label>workSlopId</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#WorkSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#SEOSlop"><rdfs:label>SEO Slop</rdfs:label><rdfs:comment>Low-value or unoriginal content produced or distributed primarily to manipulate search or generative-answer visibility.</rdfs:comment><ont:icon>🔎</ont:icon><ont:color>#008272</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-core/sEOSlop_id"><rdfs:label>sEOSlopId</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#SEOSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#DetectionEvidence"><rdfs:label>Detection Evidence</rdfs:label><rdfs:comment>An observed signal, source, measurement, or provenance fact used to support or reject a slop classification.</rdfs:comment><ont:icon>🔬</ont:icon><ont:color>#00A9E0</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-core/detectionEvidence_id"><rdfs:label>detectionEvidenceId</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#DetectionEvidence"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#Harm"><rdfs:label>Harm</rdfs:label><rdfs:comment>A negative consequence associated with a slop phenomenon, such as time waste, misinformation, trust erosion, or retrieval contamination.</rdfs:comment><ont:icon>⚠️</ont:icon><ont:color>#FFB900</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-core/harm_id"><rdfs:label>harmId</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#Harm"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#MitigationAction"><rdfs:label>Mitigation Action</rdfs:label><rdfs:comment>A review, ranking, labeling, verification, quarantine, or removal action applied to a slop risk.</rdfs:comment><ont:icon>🛡️</ont:icon><ont:color>#E81123</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-core/mitigationAction_id"><rdfs:label>mitigationActionId</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#MitigationAction"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-core/r1"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#AISlop"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#SlopPhenomenon"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>aISlop</ont:fromEntityId><ont:toEntityId>slopPhenomenon</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-core/r2"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#HumanSlop"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#SlopPhenomenon"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>humanSlop</ont:fromEntityId><ont:toEntityId>slopPhenomenon</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-core/r3"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#WorkSlop"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#SlopPhenomenon"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>workSlop</ont:fromEntityId><ont:toEntityId>slopPhenomenon</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-core/r4"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#SEOSlop"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#SlopPhenomenon"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>sEOSlop</ont:fromEntityId><ont:toEntityId>slopPhenomenon</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-core/r5"><rdfs:label>supports</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#DetectionEvidence"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#SlopPhenomenon"/><ont:cardinality>many-to-many</ont:cardinality><ont:fromEntityId>detectionEvidence</ont:fromEntityId><ont:toEntityId>slopPhenomenon</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-core/r6"><rdfs:label>causes</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#SlopPhenomenon"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#Harm"/><ont:cardinality>many-to-many</ont:cardinality><ont:fromEntityId>slopPhenomenon</ont:fromEntityId><ont:toEntityId>harm</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-core/r7"><rdfs:label>mitigates</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#MitigationAction"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#SlopPhenomenon"/><ont:cardinality>many-to-many</ont:cardinality><ont:fromEntityId>mitigationAction</ont:fromEntityId><ont:toEntityId>slopPhenomenon</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-core/r8"><rdfs:label>canOverlapWith</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#AISlop"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#WorkSlop"/><ont:cardinality>many-to-many</ont:cardinality><ont:fromEntityId>aISlop</ont:fromEntityId><ont:toEntityId>workSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-core/r9"><rdfs:label>canOverlapWith</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#AISlop"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#SEOSlop"/><ont:cardinality>many-to-many</ont:cardinality><ont:fromEntityId>aISlop</ont:fromEntityId><ont:toEntityId>sEOSlop</ont:toEntityId></owl:ObjectProperty>
</rdf:RDF>
