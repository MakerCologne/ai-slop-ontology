<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xml:base="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-intent/" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:ont="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-intent/">
<owl:Ontology rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-intent/"><rdfs:label>AI Slop by Intent</rdfs:label><rdfs:comment>AI Slop organized by engagement, monetization, propaganda, recommendation poisoning, search manipulation, impersonation, and filler publishing.</rdfs:comment></owl:Ontology>
<owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#AISlop"><rdfs:label>AI Slop</rdfs:label><rdfs:comment>A slop phenomenon in which generative AI is a primary production source and human care, verification, or intentional curation is insufficient.</rdfs:comment><ont:icon>🤖</ont:icon><ont:color>#0078D4</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-intent/aiSlop_id"><rdfs:label>aiSlopId</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#AISlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#EngagementClickbaitSlop"><rdfs:label>Engagement Clickbait Slop</rdfs:label><rdfs:comment>AI content designed mainly to trigger likes, shares, watch time, or emotional reactions rather than provide durable value.</rdfs:comment><ont:icon>🪝</ont:icon><ont:color>#107C10</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-intent/engagementClickbaitSlop_id"><rdfs:label>engagementClickbaitSlopId</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#EngagementClickbaitSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#MonetizationSlop"><rdfs:label>Monetization Slop</rdfs:label><rdfs:comment>AI content produced mainly to extract advertising, affiliate, subscription, royalty, or platform incentive revenue.</rdfs:comment><ont:icon>💰</ont:icon><ont:color>#D83B01</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-intent/monetizationSlop_id"><rdfs:label>monetizationSlopId</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#MonetizationSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#PropagandaDisinfoSlop"><rdfs:label>Propaganda Disinfo Slop</rdfs:label><rdfs:comment>AI-generated propaganda or disinformation optimized for repetition, saturation, identity manipulation, or false belief formation.</rdfs:comment><ont:icon>📣</ont:icon><ont:color>#5C2D91</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-intent/propagandaDisinfoSlop_id"><rdfs:label>propagandaDisinfoSlopId</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#PropagandaDisinfoSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#RecommendationPoisoningSlop"><rdfs:label>Recommendation Poisoning Slop</rdfs:label><rdfs:comment>AI content placed or replicated to distort recommendation, retrieval, or agent selection systems.</rdfs:comment><ont:icon>☣️</ont:icon><ont:color>#008272</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-intent/recommendationPoisoningSlop_id"><rdfs:label>recommendationPoisoningSlopId</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#RecommendationPoisoningSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#SEOContentFarmSlop"><rdfs:label>SEO/Content Farm Slop</rdfs:label><rdfs:comment>AI content engineered mainly to gain ranking or answer-engine visibility rather than satisfy user intent.</rdfs:comment><ont:icon>📈</ont:icon><ont:color>#00A9E0</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-intent/seoContentFarmSlop_id"><rdfs:label>seoContentFarmSlopId</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#SEOContentFarmSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#ImpersonationSlop"><rdfs:label>Impersonation Slop</rdfs:label><rdfs:comment>AI-generated content that imitates a person, organization, artist, brand, or authoritative source without legitimate authorization or clarity.</rdfs:comment><ont:icon>🎭</ont:icon><ont:color>#FFB900</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-intent/impersonationSlop_id"><rdfs:label>impersonationSlopId</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#ImpersonationSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="https://github.com/hikaman/ai-slop-ontology#PlaceholderPublishingSlop"><rdfs:label>Placeholder Publishing Slop</rdfs:label><rdfs:comment>Draft-like or filler AI output published as finished content without sufficient review, evidence, or audience-specific purpose.</rdfs:comment><ont:icon>🧱</ont:icon><ont:color>#E81123</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-intent/placeholderPublishingSlop_id"><rdfs:label>placeholderPublishingSlopId</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#PlaceholderPublishingSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-intent/r1"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#EngagementClickbaitSlop"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#AISlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>engagementClickbaitSlop</ont:fromEntityId><ont:toEntityId>aiSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-intent/r2"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#MonetizationSlop"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#AISlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>monetizationSlop</ont:fromEntityId><ont:toEntityId>aiSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-intent/r3"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#PropagandaDisinfoSlop"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#AISlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>propagandaDisinfoSlop</ont:fromEntityId><ont:toEntityId>aiSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-intent/r4"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#RecommendationPoisoningSlop"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#AISlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>recommendationPoisoningSlop</ont:fromEntityId><ont:toEntityId>aiSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-intent/r5"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#SEOContentFarmSlop"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#AISlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>seoContentFarmSlop</ont:fromEntityId><ont:toEntityId>aiSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-intent/r6"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#ImpersonationSlop"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#AISlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>impersonationSlop</ont:fromEntityId><ont:toEntityId>aiSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-intent/r7"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#PlaceholderPublishingSlop"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#AISlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>placeholderPublishingSlop</ont:fromEntityId><ont:toEntityId>aiSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-intent/r8"><rdfs:label>canServe</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#EngagementClickbaitSlop"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#MonetizationSlop"/><ont:cardinality>many-to-many</ont:cardinality><ont:fromEntityId>engagementClickbaitSlop</ont:fromEntityId><ont:toEntityId>monetizationSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/ai-slop-intent/r9"><rdfs:label>canUse</rdfs:label><rdfs:domain rdf:resource="https://github.com/hikaman/ai-slop-ontology#PropagandaDisinfoSlop"/><rdfs:range rdf:resource="https://github.com/hikaman/ai-slop-ontology#ImpersonationSlop"/><ont:cardinality>many-to-many</ont:cardinality><ont:fromEntityId>propagandaDisinfoSlop</ont:fromEntityId><ont:toEntityId>impersonationSlop</ont:toEntityId></owl:ObjectProperty>
</rdf:RDF>
