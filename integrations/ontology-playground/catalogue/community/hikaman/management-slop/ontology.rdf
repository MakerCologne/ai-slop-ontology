<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xml:base="https://github.com/hikaman/ai-slop-ontology" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:ont="urn:ontology-playground:">
<owl:Ontology rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/management-slop/"><rdfs:label>Management Slop</rdfs:label><rdfs:comment>Management Slop types covering strategy, jargon, meetings, decisions, metrics, administration, and compliance.</rdfs:comment></owl:Ontology>
<owl:Class rdf:about="#ManagementSlop"><rdfs:label>Management Slop</rdfs:label><rdfs:comment>Management artifacts or rituals whose apparent legitimacy exceeds their organizational contribution.</rdfs:comment><ont:icon>🧭</ont:icon><ont:color>#0078D4</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="#p1"><rdfs:label>managementSlopId</rdfs:label><rdfs:domain rdf:resource="#ManagementSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="#StrategySlop"><rdfs:label>Strategy Slop</rdfs:label><rdfs:comment>Strategic language or plans that remain ambiguous, unfalsifiable, or disconnected from resource choices.</rdfs:comment><ont:icon>♟️</ont:icon><ont:color>#107C10</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="#p2"><rdfs:label>strategySlopId</rdfs:label><rdfs:domain rdf:resource="#StrategySlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="#JargonSlop"><rdfs:label>Jargon Slop</rdfs:label><rdfs:comment>Impressive organizational language that is semantically empty or needlessly obscures action.</rdfs:comment><ont:icon>💭</ont:icon><ont:color>#D83B01</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="#p3"><rdfs:label>jargonSlopId</rdfs:label><rdfs:domain rdf:resource="#JargonSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="#MeetingSlop"><rdfs:label>Meeting Slop</rdfs:label><rdfs:comment>A meeting whose participant cost exceeds objective achievement without justified synchronous need.</rdfs:comment><ont:icon>🗓️</ont:icon><ont:color>#5C2D91</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="#p4"><rdfs:label>meetingSlopId</rdfs:label><rdfs:domain rdf:resource="#MeetingSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="#DecisionSlop"><rdfs:label>Decision Slop</rdfs:label><rdfs:comment>A decision ritual without traceable evidence, ownership, constraints, or commitment.</rdfs:comment><ont:icon>🚦</ont:icon><ont:color>#008272</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="#p5"><rdfs:label>decisionSlopId</rdfs:label><rdfs:domain rdf:resource="#DecisionSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="#MetricsSlop"><rdfs:label>Metrics Slop</rdfs:label><rdfs:comment>Metrics or dashboards rewarding proxy optimization and reporting activity over outcomes.</rdfs:comment><ont:icon>📊</ont:icon><ont:color>#00A9E0</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="#p6"><rdfs:label>metricsSlopId</rdfs:label><rdfs:domain rdf:resource="#MetricsSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="#AdministrativeSlop"><rdfs:label>Administrative Slop</rdfs:label><rdfs:comment>Administrative requirements consuming effort without proportionate contribution to legitimate goals.</rdfs:comment><ont:icon>🗂️</ont:icon><ont:color>#FFB900</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="#p7"><rdfs:label>administrativeSlopId</rdfs:label><rdfs:domain rdf:resource="#AdministrativeSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="#ComplianceSlop"><rdfs:label>Compliance Slop</rdfs:label><rdfs:comment>Compliance controls optimized for proof of activity rather than meaningful risk reduction.</rdfs:comment><ont:icon>📑</ont:icon><ont:color>#E81123</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="#p8"><rdfs:label>complianceSlopId</rdfs:label><rdfs:domain rdf:resource="#ComplianceSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:ObjectProperty rdf:about="#r1"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="#StrategySlop"/><rdfs:range rdf:resource="#ManagementSlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>strategySlop</ont:fromEntityId><ont:toEntityId>managementSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="#r2"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="#JargonSlop"/><rdfs:range rdf:resource="#ManagementSlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>jargonSlop</ont:fromEntityId><ont:toEntityId>managementSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="#r3"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="#MeetingSlop"/><rdfs:range rdf:resource="#ManagementSlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>meetingSlop</ont:fromEntityId><ont:toEntityId>managementSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="#r4"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="#DecisionSlop"/><rdfs:range rdf:resource="#ManagementSlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>decisionSlop</ont:fromEntityId><ont:toEntityId>managementSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="#r5"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="#MetricsSlop"/><rdfs:range rdf:resource="#ManagementSlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>metricsSlop</ont:fromEntityId><ont:toEntityId>managementSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="#r6"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="#AdministrativeSlop"/><rdfs:range rdf:resource="#ManagementSlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>administrativeSlop</ont:fromEntityId><ont:toEntityId>managementSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="#r7"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="#ComplianceSlop"/><rdfs:range rdf:resource="#AdministrativeSlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>complianceSlop</ont:fromEntityId><ont:toEntityId>administrativeSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="#r8"><rdfs:label>canObscure</rdfs:label><rdfs:domain rdf:resource="#JargonSlop"/><rdfs:range rdf:resource="#StrategySlop"/><ont:cardinality>many-to-many</ont:cardinality><ont:fromEntityId>jargonSlop</ont:fromEntityId><ont:toEntityId>strategySlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="#r9"><rdfs:label>canDelay</rdfs:label><rdfs:domain rdf:resource="#MeetingSlop"/><rdfs:range rdf:resource="#DecisionSlop"/><ont:cardinality>many-to-many</ont:cardinality><ont:fromEntityId>meetingSlop</ont:fromEntityId><ont:toEntityId>decisionSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="#r10"><rdfs:label>canDistort</rdfs:label><rdfs:domain rdf:resource="#MetricsSlop"/><rdfs:range rdf:resource="#DecisionSlop"/><ont:cardinality>many-to-many</ont:cardinality><ont:fromEntityId>metricsSlop</ont:fromEntityId><ont:toEntityId>decisionSlop</ont:toEntityId></owl:ObjectProperty>
</rdf:RDF>
