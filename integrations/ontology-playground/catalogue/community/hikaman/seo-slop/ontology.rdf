<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xml:base="https://github.com/hikaman/ai-slop-ontology" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:ont="urn:ontology-playground:">
<owl:Ontology rdf:about="https://github.com/hikaman/ai-slop-ontology/playground/seo-slop/"><rdfs:label>SEO Slop</rdfs:label><rdfs:comment>Technology-neutral SEO Slop covering scaled content, doorway pages, reputation abuse, expired domains, scraped remix, search saturation, and GEO manipulation.</rdfs:comment></owl:Ontology>
<owl:Class rdf:about="#SEOSlop"><rdfs:label>SEO Slop</rdfs:label><rdfs:comment>Low-value or unoriginal content distributed mainly to manipulate search or answer visibility.</rdfs:comment><ont:icon>🔎</ont:icon><ont:color>#0078D4</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="#p1"><rdfs:label>seoSlopId</rdfs:label><rdfs:domain rdf:resource="#SEOSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="#ScaledContentSlop"><rdfs:label>Scaled Content Slop</rdfs:label><rdfs:comment>Large volumes of low-value pages produced mainly to manipulate search rankings.</rdfs:comment><ont:icon>🏭</ont:icon><ont:color>#107C10</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="#p2"><rdfs:label>scaledContentSlopId</rdfs:label><rdfs:domain rdf:resource="#ScaledContentSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="#DoorwayPageSlop"><rdfs:label>Doorway Page Slop</rdfs:label><rdfs:comment>Near-duplicate pages targeting related queries that funnel users elsewhere.</rdfs:comment><ont:icon>🚪</ont:icon><ont:color>#D83B01</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="#p3"><rdfs:label>doorwayPageSlopId</rdfs:label><rdfs:domain rdf:resource="#DoorwayPageSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="#SiteReputationSlop"><rdfs:label>Site Reputation Slop</rdfs:label><rdfs:comment>Detached content placed on an established host mainly to borrow ranking signals.</rdfs:comment><ont:icon>🏷️</ont:icon><ont:color>#5C2D91</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="#p4"><rdfs:label>siteReputationSlopId</rdfs:label><rdfs:domain rdf:resource="#SiteReputationSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="#ExpiredDomainSlop"><rdfs:label>Expired Domain Slop</rdfs:label><rdfs:comment>Low-value content on a repurposed domain exploiting inherited reputation or backlinks.</rdfs:comment><ont:icon>⌛</ont:icon><ont:color>#008272</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="#p5"><rdfs:label>expiredDomainSlopId</rdfs:label><rdfs:domain rdf:resource="#ExpiredDomainSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="#ScrapedRemixSlop"><rdfs:label>Scraped Remix Slop</rdfs:label><rdfs:comment>Scraped, translated, stitched, or lightly transformed material without substantial original value.</rdfs:comment><ont:icon>♻️</ont:icon><ont:color>#00A9E0</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="#p6"><rdfs:label>scrapedRemixSlopId</rdfs:label><rdfs:domain rdf:resource="#ScrapedRemixSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="#SearchSaturationSlop"><rdfs:label>Search Saturation Slop</rdfs:label><rdfs:comment>Coordinated pages or sites designed to occupy many results or dominate retrieval.</rdfs:comment><ont:icon>🌊</ont:icon><ont:color>#FFB900</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="#p7"><rdfs:label>searchSaturationSlopId</rdfs:label><rdfs:domain rdf:resource="#SearchSaturationSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:Class rdf:about="#GEOManipulationSlop"><rdfs:label>GEO Manipulation Slop</rdfs:label><rdfs:comment>Content engineered mainly to manipulate generative search or answer systems.</rdfs:comment><ont:icon>🧠</ont:icon><ont:color>#E81123</ont:color></owl:Class>
<owl:DatatypeProperty rdf:about="#p8"><rdfs:label>geoManipulationSlopId</rdfs:label><rdfs:domain rdf:resource="#GEOManipulationSlop"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier><ont:propertyType>string</ont:propertyType></owl:DatatypeProperty>
<owl:ObjectProperty rdf:about="#r1"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="#ScaledContentSlop"/><rdfs:range rdf:resource="#SEOSlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>scaledContentSlop</ont:fromEntityId><ont:toEntityId>seoSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="#r2"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="#DoorwayPageSlop"/><rdfs:range rdf:resource="#SEOSlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>doorwayPageSlop</ont:fromEntityId><ont:toEntityId>seoSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="#r3"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="#SiteReputationSlop"/><rdfs:range rdf:resource="#SEOSlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>siteReputationSlop</ont:fromEntityId><ont:toEntityId>seoSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="#r4"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="#ExpiredDomainSlop"/><rdfs:range rdf:resource="#SEOSlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>expiredDomainSlop</ont:fromEntityId><ont:toEntityId>seoSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="#r5"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="#ScrapedRemixSlop"/><rdfs:range rdf:resource="#SEOSlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>scrapedRemixSlop</ont:fromEntityId><ont:toEntityId>seoSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="#r6"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="#SearchSaturationSlop"/><rdfs:range rdf:resource="#SEOSlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>searchSaturationSlop</ont:fromEntityId><ont:toEntityId>seoSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="#r7"><rdfs:label>isSubtypeOf</rdfs:label><rdfs:domain rdf:resource="#GEOManipulationSlop"/><rdfs:range rdf:resource="#SEOSlop"/><ont:cardinality>many-to-one</ont:cardinality><ont:fromEntityId>geoManipulationSlop</ont:fromEntityId><ont:toEntityId>seoSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="#r8"><rdfs:label>canCreate</rdfs:label><rdfs:domain rdf:resource="#ScaledContentSlop"/><rdfs:range rdf:resource="#SearchSaturationSlop"/><ont:cardinality>many-to-many</ont:cardinality><ont:fromEntityId>scaledContentSlop</ont:fromEntityId><ont:toEntityId>searchSaturationSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="#r9"><rdfs:label>canScaleInto</rdfs:label><rdfs:domain rdf:resource="#ScrapedRemixSlop"/><rdfs:range rdf:resource="#ScaledContentSlop"/><ont:cardinality>many-to-many</ont:cardinality><ont:fromEntityId>scrapedRemixSlop</ont:fromEntityId><ont:toEntityId>scaledContentSlop</ont:toEntityId></owl:ObjectProperty>
<owl:ObjectProperty rdf:about="#r10"><rdfs:label>canAmplify</rdfs:label><rdfs:domain rdf:resource="#SiteReputationSlop"/><rdfs:range rdf:resource="#GEOManipulationSlop"/><ont:cardinality>many-to-many</ont:cardinality><ont:fromEntityId>siteReputationSlop</ont:fromEntityId><ont:toEntityId>geoManipulationSlop</ont:toEntityId></owl:ObjectProperty>
</rdf:RDF>
