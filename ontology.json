  "agentUsage": {
    "description": "How agents should use this ontology",
    "workflow": [
      "1. Identify content modality (text/image/video/audio/code)",
      "2. Check for applicable signals from the signals section",
      "3. Run modality-specific detection methods",
      "4. Classify slop type(s) from slopTypes",
      "5. Measure dimensions from dimensions section",
      "6. Assess normative framing if harm evaluation needed",
      "7. Recommend countermeasures"
    ],
    "outputFormat": {
      "modality": "string",
      "slopTypes": [
        "string"
      ],
      "signalsDetected": [
        {
          "signal": "string",
          "confidence": "number",
          "evidence": "string"
        }
      ],
      "dimensions": {
        "dimension": {
          "value": "number",
          "isSlop": "boolean"
        }
      },
      "overallSlopScore": "number (0-1)",
      "severity": "critical|high|medium|low|clean",
      "countermeasures": [
        "string"
      ]
    }
  },
  "relatedResearch": {
    "predictSlopBeforeItHappens": {
      "url": "https://github.com/Hypogenic-AI/predict-slop-ai-claude",
      "description": "Research project investigating whether slop genres can be predicted before they become prevalent.",
