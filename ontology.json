{
  "@context": {
    "@vocab": "http://btm.one/ontology/ai-slop#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "dc": "http://purl.org/dc/elements/1.1/"
  },
  "@type": "Ontology",
  "dc:title": "AI Slop Ontology",
  "dc:description": "Machine-readable ontology for classifying, detecting, and reasoning about AI-generated slop content.",
  "dc:creator": "Stefan / BTM.one",
  "dc:date": "2026-05-20",
  "dc:source": "Shaib et al. 2025, Kommers et al. 2026, SlopDetector.org, MINT Lab 2026",
  "mediaTypes": {
    "Text": {
      "label": "Text",
      "detection_methods": [
        "PerplexityAnalysis",
        "BurstinessAnalysis",
        "RepetitionAnalysis",
        "InformationDensityAnalysis",
        "BuzzwordFrequencyAnalysis",
        "PunctuationAnalysis",
        "StructuralAnalysis",
        "FactualityCheck",
        "SourceVerification"
      ]
    },
    "Image": {
      "label": "Image",
      "detection_methods": [
        "VisualArtifactDetection",
        "ReverseImageSearch",
        "HSVarianceAnalysis"
      ]
    },
    "Video": {
      "label": "Video",
      "detection_methods": [
        "FrameConsistencyAnalysis",
        "LipSyncAnalysis",
        "TemporalArtifactDetection"
      ]
    },
    "Audio": {
      "label": "Audio",
      "detection_methods": [
        "AudioFingerprintAnalysis",
        "VoiceConsistencyAnalysis"
      ]
    },
    "Code": {
      "label": "Code",
      "detection_methods": [
        "PackageRegistryVerification",
        "CodeStyleAnalysis",
        "HallucinationDetection",
        "SecurityVulnerabilityScan"
      ]
    }
  },
  "slopTypes": {
    "TEXT_SLOP": {
      "GenericSlop": {
        "label": "Generic Slop",
        "telltale": "In today's fast-paced world...",
        "description": "Templated, vague content with no specifics.",
        "medium": "Text",
        "signals": [
          "BuzzwordOveruse",
          "LowPerplexity",
          "UniformSentenceLength"
        ],
        "detection": [
          "RepetitionAnalysis",
          "InformationDensityAnalysis"
        ],
        "countermeasures": [
          "PromptEngineering",
          "QualityGates"
        ],
        "overlapsWith": [
          "PseudoInsightSlop"
        ]
      },
      "PseudoInsightSlop": {
        "label": "Pseudo-Insight Slop",
        "telltale": "The key is to find balance...",
        "description": "Sounds profound but communicates nothing.",
        "medium": "Text",
        "signals": [
          "GenericTransition",
          "LowPerplexity"
        ],
        "detection": [
          "InformationDensityAnalysis",
          "LogicalConsistencyCheck"
        ],
        "countermeasures": [
          "SourceAttribution",
          "HumanReview"
        ],
        "overlapsWith": [
          "GenericSlop",
          "WellnessSlop"
        ]
      },
      "FakeAuthoritySlop": {
        "label": "Fake Authority Slop",
        "telltale": "Studies have shown...",
        "description": "Confident tone with no citations or evidence.",
        "medium": "Text",
        "signals": [
          "GenericTransition"
        ],
        "detection": [
          "FactualityCheck",
          "SourceVerification"
        ],
        "countermeasures": [
          "SourceAttribution"
        ],
        "overlapsWith": [
          "WikipediaRehash"
        ]
      },
      "WikipediaRehash": {
        "label": "Wikipedia Rehash",
        "telltale": "X is defined as...",
        "description": "Rephrased common knowledge with no analysis.",
        "medium": "Text",
        "signals": [
          "LowPerplexity",
          "UniformSentenceLength"
        ],
        "detection": [
          "InformationDensityAnalysis"
        ],
        "countermeasures": [
          "PromptEngineering"
        ],
        "overlapsWith": [
          "SEOSlop"
        ]
      },
      "WellnessSlop": {
        "label": "Wellness Slop",
        "telltale": "Self-care isn't selfish...",
        "description": "Universalized self-help that applies to everyone and helps no one.",
        "medium": "Text",
        "signals": [
          "BuzzwordOveruse",
          "GenericTransition"
        ],
        "detection": [
          "InformationDensityAnalysis"
        ],
        "countermeasures": [
          "HumanReview"
        ]
      }
    },
    "IMAGE_SLOP": {
      "SurrealEngagementBait": {
        "label": "Surreal Engagement Bait (Shrimp Jesus)",
        "description": "Bizarre AI images designed for maximum engagement. Exploits the uncanny.",
        "medium": "Image",
        "signals": [
          "ExtraLimbs",
          "DistortedText",
          "SymmetryAnomaly"
        ],
        "detection": [
          "VisualArtifactDetection"
        ],
        "normative": "AttentionEconomyExploitation",
        "examples": [
          "Shrimp Jesus",
          "Cat Soap Operas"
        ]
      },
      "FakePhotographSlop": {
        "label": "Fake Photograph Slop",
        "description": "AI images presented as real photos for emotional manipulation.",
        "medium": "Image",
        "signals": [
          "UnnaturalSmoothness",
          "SymmetryAnomaly"
        ],
        "detection": [
          "VisualArtifactDetection",
          "ReverseImageSearch"
        ],
        "normative": "NonconsensualImposition",
        "examples": [
          "Veteran birthday signs",
          "Hurricane Helene fake girl with puppy"
        ]
      },
      "FakeProductImageSlop": {
        "label": "Fake Product Image",
        "description": "AI product images for items that don't exist.",
        "medium": "Image",
        "signals": [
          "DistortedText",
          "UnnaturalSmoothness"
        ],
        "detection": [
          "VisualArtifactDetection"
        ],
        "normative": "ConsumerFraud",
        "examples": [
          "Fake plant seeds on Amazon"
        ]
      }
    },
    "VIDEO_SLOP": {
      "AIGeneratedVideo": {
        "label": "AI-Generated Video Slop",
        "description": "Mass-produced AI video, especially children's/educational content with misinformation.",
        "medium": "Video",
        "signals": [
          "FrameFlicker",
          "LipSyncMismatch"
        ],
        "detection": [
          "FrameConsistencyAnalysis"
        ],
        "normative": "EpistemicPollution",
        "examples": [
          "YouTube Kids AI alphabet videos",
          "278 AI YouTube channels"
        ]
      }
    },
    "AUDIO_SLOP": {
      "FakeArtistMusic": {
        "label": "Fake Artist Music",
        "description": "AI music attributed to non-existent artists.",
        "medium": "Audio",
        "detection": [
          "AudioFingerprintAnalysis"
        ],
        "normative": "EconomicFraud",
        "examples": [
          "Velvet Sundown"
        ]
      }
    },
    "CODE_SLOP": {
      "HallucinatedPackage": {
        "label": "Hallucinated Package",
        "description": "AI suggests non-existent libraries enabling slopsquatting attacks.",
        "medium": "Code",
        "signals": [
          "InventedPackage"
        ],
        "detection": [
          "PackageRegistryVerification"
        ],
        "normative": "SecurityRisk",
        "examples": [
          "super-fast-json-parser",
          "ts-migrate-parser"
        ],
        "realWorldIncidents": [
          {
            "package": "huggingface-cli",
            "date": "2024",
            "downloads": 30000,
            "source": "Lasso Security",
            "note": "Empty package, real downloads. Alibaba copied hallucinated command into README."
          },
          {
            "package": "react-codeshift",
            "date": "2026-01",
            "spreadTo": 237,
            "source": "Aikido Security",
            "note": "No attacker. Spread organically through 47 LLM-generated Agent Skills."
          },
          {
            "package": "unused-imports",
            "date": "2026-02",
            "downloadsPerWeek": 233,
            "source": "Aikido/npm",
            "note": "Actual malware. npm security hold applied."
          }
        ],
        "stats": {
          "overallHallucinationRate": "19.7%",
          "openSourceRate": "21.7%",
          "gpt4TurboRate": "3.59%",
          "codeLlamaRate": ">33%",
          "uniqueHallucinatedNames": 205000,
          "repeatedHallucinations": "43% always repeated",
          "crossEcosystem": "8.7% hallucinated Python packages exist as npm packages"
        }
      },
      "UniformCode": {
        "label": "Uniform Code",
        "description": "Overly clean, generic code with no human customization.",
        "medium": "Code",
        "signals": [
          "UniformSentenceLength"
        ],
        "detection": [
          "CodeStyleAnalysis"
        ]
      }
    },
    "DOMAIN_SLOP": {
      "SEOSlop": {
        "label": "SEO Slop",
        "description": "Content created solely to rank in search engines.",
        "medium": "Text",
        "detection": [
          "InformationDensityAnalysis"
        ],
        "normative": "EpistemicPollution"
      },
      "AcademicSlop": {
        "label": "Academic Slop",
        "description": "AI papers, peer reviews, essays with fabricated citations.",
        "medium": "Text",
        "detection": [
          "SourceVerification",
          "FactualityCheck"
        ],
        "normative": "EpistemicPollution"
      },
      "PoliticalSlop": {
        "label": "Political Slop",
        "description": "AI political imagery/text for propaganda.",
        "medium": "Text, Image",
        "detection": [
          "SourceVerification",
          "VisualArtifactDetection"
        ],
        "normative": "DemocraticHarm",
        "examples": [
          "Trump as Pope",
          "Swifties for Trump"
        ]
      },
      "ReviewSlop": {
        "label": "Review Slop",
        "description": "AI product reviews with similar structure.",
        "medium": "Text",
        "detection": [
          "LinguisticPatternAnalysis"
        ],
        "normative": "ConsumerFraud"
      }
    },
    "BY_PURPOSE": {
      "EngagementClickbaitSlop": {
        "label": "Engagement/Clickbait Slop",
        "description": "Virales Potenzial — Motivational, Emotional Bait.",
        "examples": [
          "Veteran Birthday Signs",
          "Shrimp Jesus",
          "Cat Soap Operas"
        ]
      },
      "SEOContentFarmSlop": {
        "label": "SEO/Content Farm Slop",
        "description": "Keyword-stuffed Seiten für programmatic Ads.",
        "examples": [
          "10-Ways-to-Leverage-AI articles"
        ]
      },
      "PropagandaDisinfoSlop": {
        "label": "Propaganda/Disinfo Slop",
        "description": "Politisch motiviert — AI-Images, Spamouflage.",
        "examples": [
          "Trump als Papst",
          "Spamouflage (China/Russland)"
        ]
      },
      "MonetizationSlop": {
        "label": "Monetization Slop (Slop Farmers)",
        "description": "Direkte Revenue — Facebook Bonuses, Fake Shops, Affiliate Farming.",
        "examples": [
          "Jesse Cunningham / Bonsai Mary (8.6M Pinterest Views)"
        ]
      },
      "SpamNoiseSlop": {
        "label": "Spam/Noise Slop",
        "description": "Füllmaterial ohne klaren Zweck."
      }
    },
    "BY_FORM": {
      "LowSurrealHighSurreal": {
        "axis": "Surrealismus",
        "low": "Banal-realistisch (SEO-Artikel, Fake Reviews)",
        "high": "Absurd (Shrimp Jesus, bizarre AI-Kombinationen)"
      },
      "MassVsPersonalized": {
        "axis": "Personalisierung",
        "low": "Mass — generisch, für alle",
        "high": "Personalized — zugeschnitten auf Person/Gruppe"
      },
      "PureAIVsAIAssisted": {
        "axis": "Human Oversight",
        "low": "Reines AI — kein menschlicher Input",
        "high": "AI-assisted mit minimal Edits"
      }
    }
  },
  "dimensions": {
    "InformationUtility": {
      "Density": {
        "code": "IU1",
        "description": "Unique words / total words. < 0.40 = slop.",
        "metric": "unique_words / total_words",
        "threshold": "< 0.40 = LOW density slop",
        "automated": true,
        "expertAgreement": 5
      },
      "Relevance": {
        "code": "IU2",
        "description": "How well content addresses its stated topic.",
        "automated": false,
        "expertAgreement": 9,
        "note": "Best assessed by LLM-as-judge"
      }
    },
    "InformationQuality": {
      "Factuality": {
        "code": "IQ1",
        "description": "Whether claims are factually correct.",
        "automated": false,
        "expertAgreement": 7
      },
      "Bias": {
        "code": "IQ2",
        "description": "Systematic skew reflecting training data biases.",
        "automated": false,
        "expertAgreement": 2
      }
    },
    "StyleQuality": {
      "Repetition": {
        "code": "SQ1",
        "description": "Excessive reuse of words/phrases/structures.",
        "metric": "most_common_token_count / total_tokens",
        "threshold": "> 0.20 = slop",
        "automated": true,
        "expertAgreement": 7
      },
      "Templatedness": {
        "code": "SQ2",
        "description": "Predictable, formulaic structure.",
        "automated": true,
        "expertAgreement": 2,
        "note": "POS-tag sequence analysis"
      },
      "Coherence": {
        "code": "SQ3",
        "description": "Logical flow and consistency of argument.",
        "automated": false,
        "expertAgreement": 6
      },
      "Fluency": {
        "code": "SQ4",
        "description": "Surface readability. Slop is paradoxically fluent.",
        "automated": true,
        "expertAgreement": 4,
        "note": "High fluency + low density = strong slop signal"
      },
      "Verbosity": {
        "code": "SQ5",
        "description": "Many words, little substance.",
        "automated": true,
        "expertAgreement": 5
      },
      "WordComplexity": {
        "code": "SQ6",
        "description": "Unnecessarily complex vocabulary.",
        "automated": true,
        "expertAgreement": 1
      },
      "Tone": {
        "code": "SQ7",
        "description": "Uniform, unnatural tone throughout.",
        "automated": false,
        "expertAgreement": 3
      }
    },
    "PrototypicalProperties": {
      "SuperficialCompetence": {
        "description": "Grammatikalisch korrekt, photorealistisch oder strukturiert, aber ohne Tiefe, Originalität oder echte Intention.",
        "source": "Kommers et al. 2026"
      },
      "AsymmetricEffort": {
        "description": "Minimaler Input (Prompt) für massenhaften Output; fehlende menschliche Überarbeitung, Recherche oder Kreativität.",
        "source": "Kommers et al. 2026"
      },
      "MassProducibility": {
        "description": "Skalierbar für Algorithmen (SEO, Feeds), oft mit Clickbait-Elementen.",
        "source": "Kommers et al. 2026"
      }
    },
    "VarianceDimensions": {
      "InstrumentalUtility": {
        "description": "Warum wurde es erstellt?",
        "spectrum": "Monetization → Propaganda → Kunst → Trolling"
      },
      "Personalization": {
        "description": "Ist es generisch oder zugeschnitten?",
        "spectrum": "Mass (generisch) → Personalized (zugeschnitten)"
      },
      "Surrealism": {
        "description": "Wie absurd ist der Inhalt?",
        "spectrum": "Banal-realistisch (SEO-Artikel) → Absurd (Shrimp Jesus)"
      }
    },
    "KnowledgeCollapseStages": {
      "StageA_KnowledgePreservation": {
        "description": "Facts correct, instruction-following intact.",
        "risk": "low"
      },
      "StageB_KnowledgeCollapse": {
        "description": "CONFIDENTLY WRONG — Facts false but format correct. Surface metrics show no problem.",
        "risk": "critical",
        "note": "The valley of dangerous competence. Most harmful stage."
      },
      "StageC_InstructionCollapse": {
        "description": "Complete breakdown, random baseline (~28%), incoherent outputs.",
        "risk": "high_but_detectable"
      },
      "source": "Keisha et al. NeurIPS 2025"
    }
  },
  "signals": {
    "text": [
      {
        "id": "BuzzwordOveruse",
        "description": "Known AI-overused terms",
        "tiers": {
          "tier1": [
            "delve",
            "realm",
            "tapestry",
            "landscape"
          ],
          "tier2": [
            "unleash",
            "unlock",
            "harness",
            "leverage"
          ],
          "tier3": [
            "paradigm",
            "synergy",
            "robust"
          ],
          "tier4": [
            "cutting-edge",
            "state-of-the-art",
            "game-changing"
          ]
        },
        "threshold": "> 3 occurrences across tiers",
        "confidence": 0.8
      },
      {
        "id": "PunctuationAnomaly",
        "description": "Excessive em-dashes, ellipses, exclamations",
        "thresholds": {
          "emDash": "> 0.5/sentence",
          "ellipsis": "> 0.3/sentence",
          "exclamation": "> 0.2/sentence"
        },
        "confidence": 0.85
      },
      {
        "id": "GenericTransition",
        "phrases": [
          "it's important to note",
          "in conclusion",
          "to sum up",
          "as previously mentioned",
          "furthermore",
          "moreover"
        ],
        "threshold": "> 2 occurrences",
        "confidence": 0.75
      },
      {
        "id": "LowPerplexity",
        "description": "Text perplexity below threshold",
        "threshold": "< 50 PPL (AI), > 100 PPL (human)",
        "confidence": 0.75
      },
      {
        "id": "UniformSentenceLength",
        "description": "Low burstiness, all sentences similar length",
        "confidence": 0.7
      }
    ],
    "image": [
      {
        "id": "ExtraLimbs",
        "description": "Additional limbs, fingers, distorted features",
        "confidence": 0.9
      },
      {
        "id": "UnnaturalSmoothness",
        "description": "Flawless textures with no variation",
        "confidence": 0.7
      },
      {
        "id": "DistortedText",
        "description": "Garbled text within images",
        "confidence": 0.95
      },
      {
        "id": "SymmetryAnomaly",
        "description": "Overly symmetric patterns",
        "confidence": 0.7
      }
    ],
    "video": [
      {
        "id": "FrameFlicker",
        "description": "Inconsistent objects between frames",
        "confidence": 0.85
      },
      {
        "id": "LipSyncMismatch",
        "description": "Audio-visual desync",
        "confidence": 0.9
      }
    ],
    "code": [
      {
        "id": "InventedPackage",
        "description": "Non-existent libraries",
        "knownExamples": [
          "super-fast-json-parser",
          "ts-migrate-parser",
          "fast-data-processor"
        ],
        "confidence": 1.0
      },
      {
        "id": "HardcodedSecret",
        "description": "API keys/passwords in code",
        "confidence": 0.95
      }
    ]
  },
  "normativeFramings": {
    "EpistemicPollution": {
      "description": "Degrades information ecosystem. Knowledge collapse: society 2.3x further from truth at 20% AI cost discount.",
      "harms": [
        "KnowledgeCollapse",
        "ModelCollapse"
      ]
    },
    "AutomationBias": {
      "description": "Humans over-defer to automated outputs. Cognitive reflection does NOT protect.",
      "harms": [
        "OverrelianceOnAI",
        "FalseBeliefAmplification"
      ]
    },
    "IllegitimateReasonGiving": {
      "description": "AI presents as testimony but lacks epistemic standing, accountability, communicative intention.",
      "source": "Enoch 2012"
    },
    "NonconsensualImposition": {
      "description": "Sending unreviewed AI output = coercing strangers into unpaid evaluation labour.",
      "source": "Doctorow 2026"
    },
    "AttentionEconomyExploitation": {
      "description": "Content optimized for engagement, not information."
    },
    "ConsumerFraud": {
      "description": "Fake products/reviews deceive consumers."
    },
    "SecurityRisk": {
      "description": "Hallucinated packages enable supply chain attacks."
    },
    "DemocraticHarm": {
      "description": "Political slop undermines democratic discourse."
    },
    "SupplyChainAttack": {
      "description": "AI hallucinated package names enable zero-skill supply chain attacks. Attacker needs only free registry account.",
      "harms": [
        "CredentialTheft",
        "BackdoorInstallation",
        "OrganicSpread"
      ],
      "mitigatedBy": "PackageRegistryVerification, HumanReview, SCA Scanning"
    },
    "EngagementFarming": {
      "description": "AI slop is not exogenous but a consequence of engagement-farming political economy. Platforms reward engagement regardless of quality. AI reduces production cost to ~0.",
      "source": "Mark Carrigan 2026",
      "harms": [
        "CreatorDisplacement",
        "InformationEcosystemDegradation"
      ]
    }
  },
  "countermeasures": {
    "detection": {
      "LinguisticPatterns": "Buzzword-Frequenz, Em-Dash-Rate, Sentence-Burstiness",
      "StatisticalAnalysis": "Perplexity, Information Density, Repetition Ratio",
      "Watermarking": "Kryptographische Token-Partitionierung (Green/Red Lists)",
      "CommunityTools": [
        "Kagi SlopStop",
        "SlopDetector.org",
        "GPTZero",
        "Originality.ai"
      ]
    },
    "platforms": {
      "Moderation": "Bessere automatische Erkennung von AI-Slop",
      "Labeling": "AI-Content Kennzeichnungspflicht",
      "AlgorithmAdjustment": "Quality-Signals statt reinen Engagement-Signals"
    },
    "userAgentLevel": {
      "ProvenanceChecks": "Herkunft verifizieren (C2PA, Watermarks, Reverse Image Search)",
      "QualityScoring": "Slop Score berechnen (Density, Repetition, Verbosity)"
    },
    "risks": {
      "ArmsRace": "Bessere Generatoren umgehen Detection — kat-and-mouse game",
      "PositivePotenzial": "Sorgfältige AI-Nutzung ist KEIN Slop — Unterscheidung bleibt wichtig"
    }
  },
