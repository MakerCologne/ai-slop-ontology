{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lexikon/schema/entry.schema.json",
  "title": "Slop-Lexikon Entry v1",
  "description": "Schema-first SSOT: one concept, one YAML source, many generated views. Claims carry their own evidence (url + quote + accessed), Wikidata-statement style. Validated by scripts/build_lexikon.py (subset of draft-07: type, required, properties, items, enum, minItems, additionalProperties).",
  "type": "object",
  "required": ["id", "term", "definition", "category", "claims", "status", "version"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^LEX-[0-9]{4}-[0-9]{3}$"},
    "term": {"type": "string", "minLength": 2},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "definition": {"type": "string", "minLength": 20},
    "category": {"type": "string", "enum": ["signal", "pattern", "type", "counter"]},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["statement", "sources"],
        "additionalProperties": false,
        "properties": {
          "statement": {"type": "string", "minLength": 10},
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["url", "quote", "accessed"],
              "additionalProperties": false,
              "properties": {
                "url": {"type": "string", "pattern": "^https?://"},
                "quote": {"type": "string", "minLength": 8},
                "accessed": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
              }
            }
          }
        }
      }
    },
    "detect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "regex": {"type": "array", "items": {"type": "string"}},
        "hints": {"type": "array", "items": {"type": "string"}}
      }
    },
    "counter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "measure": {"type": "string"},
        "keep_when": {"type": "string"}
      }
    },
    "status": {"type": "string", "enum": ["nursery", "beta", "stable"]},
    "version": {"type": "integer", "minimum": 1},
    "see_also": {"type": "array", "items": {"type": "string"}}
  }
}
