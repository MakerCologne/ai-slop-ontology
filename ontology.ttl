@prefix : <http://btm.one/ontology/ai-slop#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix skos: <http://www.w3.org/2004/01/skos/core#> .

<http://btm.one/ontology/ai-slop> a owl:Ontology ;
    dc:title "AI Slop Ontology" ;
    dc:description "A machine-readable ontology for classifying, detecting, and reasoning about AI-generated slop content across all media types." ;
    dc:creator "Stefan / BTM.one" ;
    dc:date "2026-07-10" ;
    dc:source "Shaib et al. 2025, Kommers et al. 2026, Nishal et al. 2026, SlopDetector.org, MINT Lab 2026, NewsGuard 2026" ;
    rdfs:comment "Designed for agent consumption — agents can load this ontology to understand, classify, detect, and countermeasure AI slop." .

# ============================================================================
# CLASSES
# ============================================================================

# --- Core Entity ---

:SlopInstance a owl:Class ;
    rdfs:label "Slop Instance" ;
    rdfs:comment "A concrete observation of AI slop content. The central entity of this ontology." .

# --- Classification ---

:SlopType a owl:Class ;
    rdfs:label "Slop Type" ;
    rdfs:comment "Hierarchical classification of slop varieties." .

:SlopMedium a owl:Class ;
    rdfs:label "Slop Medium" ;
    rdfs:comment "The media type in which slop manifests." .

# --- Measurement ---

:SlopDimension a owl:Class ;
    rdfs:label "Slop Dimension" ;
    rdfs:comment "A measurable quality axis along which slop can be assessed. From Shaib et al. (2025)." .

:SlopSignal a owl:Class ;
    rdfs:label "Slop Signal" ;
    rdfs:comment "An observable indicator that suggests slop. Detectable by humans or automated tools." .

# --- Normative ---

:NormativeFraming a owl:Class ;
    rdfs:label "Normative Framing" ;
    rdfs:comment "A philosophical/ethical lens through which slop is evaluated as harmful." .

:SlopHarm a owl:Class ;
    rdfs:label "Slop Harm" ;
    rdfs:comment "A specific negative consequence of slop." .

# --- Detection & Response ---

:DetectionMethod a owl:Class ;
    rdfs:label "Detection Method" ;
    rdfs:comment "A technique for identifying slop." .

:DetectionTool a owl:Class ;
    rdfs:label "Detection Tool" ;
    rdfs:comment "A concrete software tool or service for slop detection." .

:Countermeasure a owl:Class ;
    rdfs:label "Countermeasure" ;
    rdfs:comment "An action or technique to prevent, reduce, or remediate slop." .

# --- Provenance ---

:SlopContext a owl:Class ;
    rdfs:label "Slop Context" ;
    rdfs:comment "The situational context in which slop was created or encountered." .

:SlopActor a owl:Class ;
    rdfs:label "Slop Actor" ;
    rdfs:comment "An entity (human, bot, organization) that produces or distributes slop." .

# ============================================================================
# SLOP TYPES (Hierarchical)
# ============================================================================

# --- Level 1: By Content Quality Pattern (Text) ---

:GenericSlop a :SlopType ;
    rdfs:label "Generic Slop" ;
    :telltalePhrase "In today's fast-paced world..." ;
    rdfs:comment "Templated, vague content with no specifics. The most basic form." ;
    :hasMedium :Text ;
    :detectedBy :RepetitionAnalysis , :InformationDensityAnalysis .

:PseudoInsightSlop a :SlopType ;
    rdfs:label "Pseudo-Insight Slop" ;
    :telltalePhrase "The key is to find balance..." ;
    rdfs:comment "Sounds profound but communicates nothing. Fake depth." ;
    :hasMedium :Text ;
    :detectedBy :InformationDensityAnalysis , :LogicalConsistencyCheck .

:FakeAuthoritySlop a :SlopType ;
    rdfs:label "Fake Authority Slop" ;
    :telltalePhrase "Studies have shown..." ;
    rdfs:comment "Confident tone with no citations or evidence. Unsubstantiated claims." ;
    :hasMedium :Text ;
    :detectedBy :FactualityCheck , :SourceVerification .

:WikipediaRehash a :SlopType ;
    rdfs:label "Wikipedia Rehash" ;
    :telltalePhrase "X is defined as..." ;
    rdfs:comment "Rephrased common knowledge with no original analysis or added value." ;
    :hasMedium :Text ;
    :detectedBy :OriginalityAnalysis , :InformationDensityAnalysis .

:WellnessSlop a :SlopType ;
    rdfs:label "Wellness Slop" ;
    :telltalePhrase "Self-care isn't selfish..." ;
    rdfs:comment "Universalized self-help that applies to everyone and helps no one." ;
    :hasMedium :Text ;
    :detectedBy :SpecificityCheck , :LivedExperienceCheck .

# --- Level 1: By Visual Pattern (Image) ---

:SurrealEngagementBait a :SlopType ;
    rdfs:label "Surreal Engagement Bait" ;
    rdfs:comment "Bizarre, surreal AI images designed for maximum engagement. Named after the 'Shrimp Jesus' meme. Exploits the uncanny." ;
    :hasMedium :Image ;
    :detectedBy :VisualArtifactDetection , :EngagementPatternAnalysis ;
    :hasNormativeFraming :AttentionEconomyExploitation .

:FakePhotographSlop a :SlopType ;
    rdfs:label "Fake Photograph Slop" ;
    rdfs:comment "AI-generated images presented as real photographs, often for emotional manipulation (veteran birthdays, disaster victims)." ;
    :hasMedium :Image ;
    :detectedBy :VisualArtifactDetection , :ReverseImageSearch ;
    :hasNormativeFraming :NonconsensualImposition .

:FakeProductImageSlop a :SlopType ;
    rdfs:label "Fake Product Image Slop" ;
    rdfs:comment "AI-generated product images for items that don't exist (fake plants, fake food)." ;
    :hasMedium :Image ;
    :detectedBy :VisualArtifactDetection , :MarketplaceCrossReference ;
    :hasNormativeFraming :ConsumerFraud .

# --- Level 1: By Audio/Video Pattern ---

:FakeArtistMusic a :SlopType ;
    rdfs:label "Fake Artist Music Slop" ;
    rdfs:comment "AI-generated music attributed to non-existent artists. Accumulates streams before detection." ;
    :hasMedium :Audio ;
    :detectedBy :AudioFingerprintAnalysis , :ArtistVerification ;
    :hasNormativeFraming :EconomicFraud .

:AIGeneratedVideo a :SlopType ;
    rdfs:label "AI-Generated Video Slop" ;
    rdfs:comment "Mass-produced AI video content, especially children's content and educational videos with misinformation." ;
    :hasMedium :Video ;
    :detectedBy :FrameConsistencyAnalysis , :ContentQualityReview ;
    :hasNormativeFraming :EpistemicPollution .

# --- Level 1: By Code Pattern ---

:HallucinatedPackage a :SlopType ;
    rdfs:label "Hallucinated Package Slop" ;
    rdfs:comment "AI suggests non-existent libraries/packages, enabling 'slopsquatting' attacks." ;
    :hasMedium :Code ;
    :detectedBy :PackageRegistryVerification ;
    :hasNormativeFraming :SecurityRisk .

:UniformCode a :SlopType ;
    rdfs:label "Uniform Code Slop" ;
    rdfs:comment "Overly clean, generic code style with no human customization or iterative history." ;
    :hasMedium :Code ;
    :detectedBy :CodeStyleAnalysis , :DocumentationGapDetection .

# --- Level 1: By Domain ---

:SEOSlop a :SlopType ;
    rdfs:label "SEO Slop" ;
    rdfs:comment "Content created solely to rank in search engines, with no informational value." ;
    :hasMedium :Text ;
    :detectedBy :InformationDensityAnalysis , :SEOHeuristicAnalysis ;
    :hasNormativeFraming :EpistemicPollution .

:AcademicSlop a :SlopType ;
    rdfs:label "Academic Slop" ;
    rdfs:comment "AI-generated papers, peer reviews, or essays with fabricated citations." ;
    :hasMedium :Text ;
    :detectedBy :CitationVerification , :StyleConsistencyAnalysis ;
    :hasNormativeFraming :EpistemicPollution .

:PeerReviewSlop a :SlopType ;
    rdfs:label "Peer Review Slop" ;
    rdfs:comment "AI-generated peer reviews: fluent, generic feedback without engagement with the manuscript. Organization Science (2026): >30% of reviews AI-involved." ;
    :hasMedium :Text ;
    :detectedBy :StyleConsistencyAnalysis ;
    :hasNormativeFraming :EpistemicPollution .

:SecurityReportSlop a :SlopType ;
    rdfs:label "Security Report Slop" ;
    rdfs:comment "AI-generated vulnerability reports that sound technical but contain nothing actionable. Flooded curl's bug bounty (~20% of submissions mid-2025); program closed Feb 2026." ;
    :hasMedium :Text ;
    :detectedBy :SourceVerification ;
    :hasNormativeFraming :SecurityRisk .

:PoliticalSlop a :SlopType ;
    rdfs:label "Political Slop" ;
    rdfs:comment "AI-generated political imagery or text for propaganda and engagement farming." ;
    :hasMedium :Text, :Image ;
    :detectedBy :SourceVerification , :VisualArtifactDetection ;
    :hasNormativeFraming :DemocraticHarm .

:ReviewSlop a :SlopType ;
    rdfs:label "Review Slop" ;
    rdfs:comment "AI-generated product reviews, all using similar structure and language." ;
    :hasMedium :Text ;
    :detectedBy :ReviewSimilarityClustering , :LinguisticPatternAnalysis ;
    :hasNormativeFraming :ConsumerFraud .

# ============================================================================
# MEDIA TYPES
# ============================================================================

:Text a :SlopMedium ;
    rdfs:label "Text" ;
    :applicableDetection :PerplexityAnalysis , :BurstinessAnalysis , :RepetitionAnalysis ,
        :InformationDensityAnalysis , :BuzzwordFrequencyAnalysis , :PunctuationAnalysis ,
        :StructuralAnalysis , :FactualityCheck , :SourceVerification .

:Image a :SlopMedium ;
    rdfs:label "Image" ;
    :applicableDetection :VisualArtifactDetection , :ReverseImageSearch , :HSVarianceAnalysis .

:Video a :SlopMedium ;
    rdfs:label "Video" ;
    :applicableDetection :FrameConsistencyAnalysis , :LipSyncAnalysis , :TemporalArtifactDetection .

:Audio a :SlopMedium ;
    rdfs:label "Audio" ;
    :applicableDetection :AudioFingerprintAnalysis , :VoiceConsistencyAnalysis .

:Code a :SlopMedium ;
    rdfs:label "Code" ;
    :applicableDetection :PackageRegistryVerification , :CodeStyleAnalysis ,
        :HallucinationDetection , :SecurityVulnerabilityScan .

:MultiModal a :SlopMedium ;
    rdfs:label "Multi-Modal" ;
    rdfs:comment "Combinations of text, code, images, audio, video." .

# ============================================================================
# DIMENSIONS (from Shaib et al. 2025)
# ============================================================================

# Theme 1: Information Utility

:Density a :SlopDimension ;
    rdfs:label "Information Density" ;
    rdfs:comment "Ratio of unique words to total words. Low density (< 0.40) indicates verbose, low-value content." ;
    :theme "Information Utility" ;
    :code "IU1" ;
    :expertCount 5 ;
    :metric "unique_words / total_words" ;
    :slopThreshold "< 0.40" ;
    :automaticallyMeasurable true .

:Relevance a :SlopDimension ;
    rdfs:label "Relevance" ;
    rdfs:comment "How well content addresses its stated topic or prompt. Irrelevant tangents indicate slop." ;
    :theme "Information Utility" ;
    :code "IU2" ;
    :expertCount 9 ;
    :automaticallyMeasurable false ;
    rdfs:comment "Best assessed by LLM-as-judge or expert annotation." .

# Theme 2: Information Quality

:Factuality a :SlopDimension ;
    rdfs:label "Factuality" ;
    rdfs:comment "Whether claims are factually correct. Hallucinations and fabricated facts are key slop indicators." ;
    :theme "Information Quality" ;
    :code "IQ1" ;
    :expertCount 7 ;
    :automaticallyMeasurable false ;
    rdfs:comment "Requires external verification against knowledge bases." .

:Bias a :SlopDimension ;
    rdfs:label "Bias" ;
    rdfs:comment "Systematic skew in presented information, often reflecting training data biases." ;
    :theme "Information Quality" ;
    :code "IQ2" ;
    :expertCount 2 ;
    :automaticallyMeasurable false .

# Theme 3: Style Quality

:Repetition a :SlopDimension ;
    rdfs:label "Repetition" ;
    rdfs:comment "Excessive reuse of words, phrases, or sentence structures." ;
    :theme "Style Quality" ;
    :code "SQ1" ;
    :expertCount 7 ;
    :metric "most_common_token_count / total_tokens" ;
    :slopThreshold "> 0.20" ;
    :automaticallyMeasurable true .

:Templatedness a :SlopDimension ;
    rdfs:label "Templatedness" ;
    rdfs:comment "Degree to which content follows a predictable, formulaic structure." ;
    :theme "Style Quality" ;
    :code "SQ2" ;
    :expertCount 2 ;
    :automaticallyMeasurable true ;
    rdfs:comment "Measurable via POS-tag sequence analysis." .

:Coherence a :SlopDimension ;
    rdfs:label "Coherence" ;
    rdfs:comment "Logical flow and consistency of argument. Incoherent jumps indicate slop." ;
    :theme "Style Quality" ;
    :code "SQ3" ;
    :expertCount 6 ;
    :automaticallyMeasurable false .

:Fluency a :SlopDimension ;
    rdfs:label "Fluency" ;
    rdfs:comment "Surface-level readability. Slop is often paradoxically fluent (superficial competence)." ;
    :theme "Style Quality" ;
    :code "SQ4" ;
    :expertCount 4 ;
    :automaticallyMeasurable true ;
    rdfs:comment "High fluency + low density = strong slop signal." .

:Verbosity a :SlopDimension ;
    rdfs:label "Verbosity" ;
    rdfs:comment "Using many words to say little. Correlates with low information density." ;
    :theme "Style Quality" ;
    :code "SQ5" ;
    :expertCount 5 ;
    :automaticallyMeasurable true .

:WordComplexity a :SlopDimension ;
    rdfs:label "Word Complexity" ;
    rdfs:comment "Unnecessarily complex vocabulary used to appear authoritative." ;
    :theme "Style Quality" ;
    :code "SQ6" ;
    :expertCount 1 ;
    :automaticallyMeasurable true .

:Tone a :SlopDimension ;
    rdfs:label "Tone" ;
    rdfs:comment "Uniform, unnatural tone throughout. AI lacks tonal variation of human writing." ;
    :theme "Style Quality" ;
    :code "SQ7" ;
    :expertCount 3 ;
    :automaticallyMeasurable false .

# ============================================================================
# PROTOTYPICAL PROPERTIES (from Kommers et al. 2026)
# ============================================================================

:SuperficialCompetence a owl:Class ;
    rdfs:subClassOf :SlopDimension ;
    rdfs:label "Superficial Competence" ;
    rdfs:comment "A veneer of quality belied by deeper lack of substance. The defining feature of LLM slop — it looks right while being wrong." ;
    :source "Kommers et al. 2026" .

:AsymmetricEffort a owl:Class ;
    rdfs:subClassOf :SlopDimension ;
    rdfs:label "Asymmetric Effort" ;
    rdfs:comment "Creation requires vastly less labour than would be needed without AI. Effort asymmetry is observable but hard to measure from content alone." ;
    :source "Kommers et al. 2026" .

:MassProducibility a owl:Class ;
    rdfs:subClassOf :SlopDimension ;
    rdfs:label "Mass Producibility" ;
    rdfs:comment "The content exists within a digital ecosystem of widespread generation and consumption. High volume is a necessary but not sufficient condition." ;
    :source "Kommers et al. 2026" .

# Varianz-Dimensionen
:InstrumentalUtility a owl:Class ;
    rdfs:label "Instrumental Utility" ;
    rdfs:comment "Why was it created? Ranges from monetary gain → artistic expression → trolling → political propaganda." ;
    :source "Kommers et al. 2026" .

:Personalization a owl:Class ;
    rdfs:label "Personalization" ;
    rdfs:comment "Is it generic (mass audience) or personalized (specific person/group)?" ;
    :source "Kommers et al. 2026" .

:Surrealism a owl:Class ;
    rdfs:label "Surrealism" ;
    rdfs:comment "How implausible is the content? Ranges from ludicrously implausible (Shrimp Jesus) to deceptively realistic (fake photographs)." ;
    :source "Kommers et al. 2026" .

# ============================================================================
# SIGNALS
# ============================================================================

:BuzzwordOveruse a :SlopSignal ;
    rdfs:label "Buzzword Overuse" ;
    :tier1Words "delve, realm, tapestry, landscape" ;
    :tier2Words "unleash, unlock, harness, leverage" ;
    :tier3Words "paradigm, synergy, robust" ;
    :tier4Words "cutting-edge, state-of-the-art, game-changing" ;
    :slopThreshold "> 3 occurrences across tiers" ;
    :confidence 0.8 ;
    :appliesTo :Text .

:PunctuationAnomaly a :SlopSignal ;
    rdfs:label "Punctuation Anomaly" ;
    rdfs:comment "Excessive em-dashes (>0.5/sentence), ellipses (>0.3/sentence), exclamations (>0.2/sentence)." ;
    :confidence 0.85 ;
    :appliesTo :Text .

:GenericTransition a :SlopSignal ;
    rdfs:label "Generic Transition" ;
    :phrases "it's important to note, in conclusion, to sum up, as previously mentioned, furthermore, moreover" ;
    :slopThreshold "> 2 occurrences" ;
    :confidence 0.75 ;
    :appliesTo :Text .

:ExtraLimbs a :SlopSignal ;
    rdfs:label "Extra Limbs/Features" ;
    rdfs:comment "Additional limbs, fingers, or distorted features in generated images." ;
    :confidence 0.9 ;
    :appliesTo :Image .

:UnnaturalSmoothness a :SlopSignal ;
    rdfs:label "Unnatural Smoothness" ;
    rdfs:comment "Flawless textures with no natural variation." ;
    :confidence 0.7 ;
    :appliesTo :Image .

:DistortedText a :SlopSignal ;
    rdfs:label "Distorted Text in Image" ;
    rdfs:comment "Nonsensical or garbled text rendered within images." ;
    :confidence 0.95 ;
    :appliesTo :Image .

:SymmetryAnomaly a :SlopSignal ;
    rdfs:label "Over-Symmetry" ;
    rdfs:comment "Overly symmetric or repetitive visual patterns not found in nature." ;
    :confidence 0.7 ;
    :appliesTo :Image .

:FrameFlicker a :SlopSignal ;
    rdfs:label "Frame Flicker" ;
    rdfs:comment "Flickering elements or inconsistent objects between video frames." ;
    :confidence 0.85 ;
    :appliesTo :Video .

:LipSyncMismatch a :SlopSignal ;
    rdfs:label "Lip-Sync Mismatch" ;
    rdfs:comment "Audio-visual desynchronization in synthesized video." ;
    :confidence 0.9 ;
    :appliesTo :Video .

:InventedPackage a :SlopSignal ;
    rdfs:label "Invented Package/Dependency" ;
    :knownHallucinations "super-fast-json-parser, ts-migrate-parser, fast-data-processor, quick-api-helper, ultra-fast-parser, super-validator" ;
    :confidence 1.0 ;
    :appliesTo :Code .

:HardcodedSecret a :SlopSignal ;
    rdfs:label "Hardcoded Secret" ;
    rdfs:comment "API keys, passwords, or tokens embedded in AI-generated code." ;
    :confidence 0.95 ;
    :appliesTo :Code .

:LowPerplexity a :SlopSignal ;
    rdfs:label "Low Perplexity" ;
    rdfs:comment "Text perplexity below threshold, indicating AI generation." ;
    :slopThreshold "< 50 PPL (AI), > 100 PPL (human)" ;
    :confidence 0.75 ;
    :appliesTo :Text .

:UniformSentenceLength a :SlopSignal ;
    rdfs:label "Uniform Sentence Length" ;
    rdfs:comment "Low burstiness — all sentences roughly the same length and complexity." ;
    :confidence 0.7 ;
    :appliesTo :Text .

# ============================================================================
# NORMATIVE FRAMINGS
# ============================================================================

:EpistemicPollution a :NormativeFraming ;
    rdfs:label "Epistemic Pollution" ;
    rdfs:comment "Slop degrades the information ecosystem, narrowing the epistemic commons. Peterson (2025): society moves 2.3x further from truth at 20% AI content cost discount." ;
    :relatedHarm :KnowledgeCollapse , :ModelCollapse .

:AutomationBias a :NormativeFraming ;
    rdfs:label "Automation Bias" ;
    rdfs:comment "Humans systematically over-defer to automated outputs. AI slop exploits this by appearing competent." ;
    :relatedHarm :OverrelianceOnAI , :FalseBeliefAmplification .

:IllegitimateReasonGiving a :NormativeFraming ;
    rdfs:label "Illegitimate Reason-Giving" ;
    rdfs:comment "AI content presents itself as informative testimony but lacks epistemic standing, accountability, and communicative intention." ;
    :source "Enoch 2012" .

:NonconsensualImposition a :NormativeFraming ;
    rdfs:label "Nonconsensual Imposition" ;
    rdfs:comment "Sending unreviewed AI output to strangers is coercing them into unpaid evaluation labour." ;
    :source "Doctorow 2026" .

:AttentionEconomyExploitation a :NormativeFraming ;
    rdfs:label "Attention Economy Exploitation" ;
    rdfs:comment "Slop optimized for engagement metrics rather than informational value." .

:ConsumerFraud a :NormativeFraming ;
    rdfs:label "Consumer Fraud" ;
    rdfs:comment "Fake products, reviews, or descriptions that deceive consumers." .

:SecurityRisk a :NormativeFraming ;
    rdfs:label "Security Risk" ;
    rdfs:comment "Hallucinated packages enable supply chain attacks ('slopsquatting')." .

:DemocraticHarm a :NormativeFraming ;
    rdfs:label "Democratic Harm" ;
    rdfs:comment "Political slop undermines democratic discourse through fabricated imagery and misinformation." .

# ============================================================================
# HARM TYPES
# ============================================================================

:KnowledgeCollapse a :SlopHarm ;
    rdfs:label "Knowledge Collapse" ;
    rdfs:comment "Progressive forgetting of less-common elements when models train recursively on their own output. Society's beliefs narrow." ;
    :source "Peterson 2025, Shumailov et al. 2024" .

:ModelCollapse a :SlopHarm ;
    rdfs:label "Model Collapse" ;
    rdfs:comment "Recursive training on AI output causes progressive degradation until models produce nonsense." ;
    :source "Shumailov et al. 2024, Gerstgrasser et al. 2024" .

:OverrelianceOnAI a :SlopHarm ;
    rdfs:label "Overreliance on AI" ;
    rdfs:comment "Cognitive offloading to AI reduces human epistemic agency and critical thinking." .

:FalseBeliefAmplification a :SlopHarm ;
    rdfs:label "False Belief Amplification" ;
    rdfs:comment "AI-generated deceptive explanations amplify belief in false headlines. Neither cognitive reflection nor trust-in-AI attitudes protect against this." ;
    :source "Danry et al. 2024" .

:CreditErosion a :SlopHarm ;
    rdfs:label "Credit Erosion" ;
    rdfs:comment "Human creators lose rightful credit when their work is reproduced as slop." .

# ============================================================================
# DETECTION METHODS
# ============================================================================

:PerplexityAnalysis a :DetectionMethod ;
    rdfs:label "Perplexity Analysis" ;
    rdfs:comment "Measures how 'surprised' a language model is by text. Low perplexity suggests AI generation." ;
    :automated true ;
    :accuracy "0.95 AUROC in controlled settings" ;
    :limitation "Struggles with post-edited text and newer models" .

:BurstinessAnalysis a :DetectionMethod ;
    rdfs:label "Burstiness Analysis" ;
    rdfs:comment "Measures variation in sentence complexity. AI produces uniform burstiness; humans vary." ;
    :automated true .

:RepetitionAnalysis a :DetectionMethod ;
    rdfs:label "Repetition Analysis" ;
    rdfs:comment "Token frequency analysis. Ratio of most common token to total tokens." ;
    :automated true ;
    :threshold "> 0.20 = slop" .

:InformationDensityAnalysis a :DetectionMethod ;
    rdfs:label "Information Density Analysis" ;
    rdfs:comment "Unique words / total words ratio." ;
    :automated true ;
    :threshold "< 0.40 = low density slop" .

:BuzzwordFrequencyAnalysis a :DetectionMethod ;
    rdfs:label "Buzzword Frequency Analysis" ;
    rdfs:comment "Counts known AI-overused terms across severity tiers." ;
    :automated true ;
    :threshold "> 3 total occurrences = generic language slop" .

:PunctuationAnalysis a :DetectionMethod ;
    rdfs:label "Punctuation Pattern Analysis" ;
    rdfs:comment "Detects excessive em-dashes, ellipses, exclamations per sentence." ;
    :automated true .

:StructuralAnalysis a :DetectionMethod ;
    rdfs:label "Structural Analysis" ;
    rdfs:comment "Detects unnatural formatting: excessive lists, trailing morals, uniform paragraphs." ;
    :automated true .

:FactualityCheck a :DetectionMethod ;
    rdfs:label "Factuality Check" ;
    rdfs:comment "Verify claims against knowledge bases. Detect hallucinations." ;
    :automated false ;
    rdfs:comment "Requires external knowledge base or human verification." .

:SourceVerification a :DetectionMethod ;
    rdfs:label "Source Verification" ;
    rdfs:comment "Check if cited sources exist and say what they're claimed to say." ;
    :automated false .

:VisualArtifactDetection a :DetectionMethod ;
    rdfs:label "Visual Artifact Detection" ;
    rdfs:comment "Detect extra limbs, distorted features, impossible physics, unnatural lighting." ;
    :automated true ;
    rdfs:comment "HSV variance analysis: high variance (>10000) signals artifacts." .

:HyperTypicalityDetection a :DetectionMethod ;
    rdfs:label "Hyper-Typicality Detection" ;
    rdfs:comment "AI-generated faces regress to the mathematical average and look 'more typical than real faces'. Humans are trainable to near-perfect detection using this cue (ANU/PNAS 2026)." ;
    :automated false .

:ReverseImageSearch a :DetectionMethod ;
    rdfs:label "Reverse Image Search" ;
    rdfs:comment "Check if image exists elsewhere, identify manipulation." ;
    :automated true .

:FrameConsistencyAnalysis a :DetectionMethod ;
    rdfs:label "Frame Consistency Analysis" ;
    rdfs:comment "Compare consecutive frames for flickering elements." ;
    :automated true .

:PackageRegistryVerification a :DetectionMethod ;
    rdfs:label "Package Registry Verification" ;
    rdfs:comment "Check if referenced packages exist in pip/npm registries." ;
    :automated true ;
    :confidence 1.0 .

:CodeStyleAnalysis a :DetectionMethod ;
    rdfs:label "Code Style Analysis" ;
    rdfs:comment "Detect overly uniform, generic naming and structure." ;
    :automated true .

:WatermarkDetection a :DetectionMethod ;
    rdfs:label "Watermark Detection" ;
    rdfs:comment "Detect cryptographic watermarks embedded during AI generation. Green/Red token list partitioning." ;
    :automated true ;
    :limitation "Requires cooperation from content generators. Open-source models typically unwatermarked." .

:LinguisticPatternAnalysis a :DetectionMethod ;
    rdfs:label "Linguistic Pattern Analysis" ;
    rdfs:comment "Analyze sentence starts, POS-tag sequences, syntactic templates for AI patterns." ;
    :automated true ;
    :source "Shaib et al. 2024, Russell et al. 2025" .

# ============================================================================
# DETECTION TOOLS
# ============================================================================

:SlopDetector a :DetectionTool ;
    rdfs:label "SlopDetector.org" ;
    rdfs:comment "Web-based 5-category slop classifier. Free." ;
    :url "https://slopdetector.org" ;
    :classifies :GenericSlop, :PseudoInsightSlop, :FakeAuthoritySlop, :WikipediaRehash, :WellnessSlop .

:DetectGPT a :DetectionTool ;
    rdfs:label "DetectGPT" ;
    rdfs:comment "Academic tool using perplexity-based detection." ;
    :accuracy "0.95 AUROC controlled" ;
    :source "Mitchell et al. 2023" .

:Binoculars a :DetectionTool ;
    rdfs:label "Binoculars" ;
    rdfs:comment "AI text detection using paired model scoring." ;
    :source "Hans et al. 2024" .

:GPTZero a :DetectionTool ;
    rdfs:label "GPTZero" ;
    rdfs:comment "Commercial AI text detection service. Not slop-specific." .

:OriginalityAI a :DetectionTool ;
    rdfs:label "Originality.ai" ;
    rdfs:comment "Commercial AI content detection. Not slop-specific." .

:LocalAISetupSlopSkill a :DetectionTool ;
    rdfs:label "local-ai-setup Slop Detection Skill" ;
    rdfs:comment "Stefan's custom multi-modal detection skill. 22 techniques, Python-based. In hikaman/local-ai-setup." ;
    :techniques 22 ;
    :modalities "text, code, image, multi-modal" .

# ============================================================================
# COUNTERMEASURES
# ============================================================================

:PromptEngineering a :Countermeasure ;
    rdfs:label "Prompt Engineering" ;
    rdfs:comment "Add constraints, require specifics, ban buzzwords in prompts." .

:HumanReview a :Countermeasure ;
    rdfs:label "Human Review" ;
    rdfs:comment "Mandatory human review before AI output publication." .

:QualityGates a :Countermeasure ;
    rdfs:label "Quality Gates" ;
    rdfs:comment "Automated checks before content is published: density > 0.40, no hallucinated packages, no hardcoded secrets." .

:ProgressiveDisclosure a :Countermeasure ;
    rdfs:label "Progressive Disclosure" ;
    rdfs:comment "Design AI tools to show reasoning steps, not just final output." .

:SourceAttribution a :Countermeasure ;
    rdfs:label "Source Attribution" ;
    rdfs:comment "Require AI outputs to cite verifiable sources." .

:AntiSlopTraining a :Countermeasure ;
    rdfs:label "Anti-Slop Training Data" ;
    rdfs:comment "Fine-tune models to avoid slop patterns (low density, generic language)." .

:ContentAuthentication a :Countermeasure ;
    rdfs:label "Content Authentication" ;
    rdfs:comment "C2PA, watermarks, provenance chains for AI-generated content." .

:DetectionPipeline a :Countermeasure ;
    rdfs:label "Detection Pipeline" ;
    rdfs:comment "Integrate slop detection into CI/CD, content management, and publishing workflows." .

# ============================================================================
# RELATIONSHIPS (Object Properties)
# ============================================================================

:hasType a owl:ObjectProperty ;
    rdfs:domain :SlopInstance ;
    rdfs:range :SlopType ;
    rdfs:comment "Classifies a slop instance into one or more slop types." .

:hasMedium a owl:ObjectProperty ;
    rdfs:domain :SlopInstance ;
    rdfs:range :SlopMedium ;
    rdfs:comment "Identifies the media type of a slop instance." .

:hasSignal a owl:ObjectProperty ;
    rdfs:domain :SlopInstance ;
    rdfs:range :SlopSignal ;
    rdfs:comment "Links a slop instance to its detected signals." .

:hasDimension a owl:ObjectProperty ;
    rdfs:domain :SlopInstance ;
    rdfs:range :SlopDimension ;
    rdfs:comment "Links a slop instance to its measured dimensions." .

:detectedBy a owl:ObjectProperty ;
    rdfs:domain :SlopType ;
    rdfs:range :DetectionMethod ;
    rdfs:comment "Which detection methods can identify this type of slop." .

:counteredBy a owl:ObjectProperty ;
    rdfs:domain :SlopType ;
    rdfs:range :Countermeasure ;
    rdfs:comment "Which countermeasures can address this type of slop." .

:hasNormativeFraming a owl:ObjectProperty ;
    rdfs:domain :SlopType ;
    rdfs:range :NormativeFraming ;
    rdfs:comment "Which ethical/societal concerns this slop type raises." .

:relatedHarm a owl:ObjectProperty ;
    rdfs:domain :NormativeFraming ;
    rdfs:range :SlopHarm ;
    rdfs:comment "Which concrete harms this framing identifies." .

:appliesTo a owl:ObjectProperty ;
    rdfs:domain :SlopSignal ;
    rdfs:range :SlopMedium ;
    rdfs:comment "Which media type this signal applies to." .

:applicableDetection a owl:ObjectProperty ;
    rdfs:domain :SlopMedium ;
    rdfs:range :DetectionMethod ;
    rdfs:comment "Which detection methods work for this medium." .

:variantOf a owl:ObjectProperty ;
    rdfs:domain :SlopType ;
    rdfs:range :SlopType ;
    rdfs:comment "Indicates a subtype relationship." .

:overlapsWith a owl:ObjectProperty ;
    rdfs:domain :SlopType ;
    rdfs:range :SlopType ;
    rdfs:comment "Slop types that frequently co-occur." .

# ============================================================================
# DATA PROPERTIES
# ============================================================================

:telltalePhrase a owl:DatatypeProperty ;
    rdfs:domain :SlopType ;
    rdfs:range xsd:string .

:confidence a owl:DatatypeProperty ;
    rdfs:domain :SlopSignal ;
    rdfs:range xsd:decimal .

:slopThreshold a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:metric a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:automaticallyMeasurable a owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

:expertCount a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

:source a owl:DatatypeProperty ;
    rdfs:range xsd:string .

# ============================================================================
# ROUND 3 ADDITIONS: Detection Red Flags, Ecosystem, Dynamics
# ============================================================================

# --- Red Flags (Expanded) ---

:EmojisInCode a :SlopSignal ;
    rdfs:label "Emojis in Code" ;
    rdfs:comment "Emojis in code comments or documentation — strong AI code slop indicator." ;
    :confidence 0.85 ;
    :appliesTo :Code .

:GlossyTextures a :SlopSignal ;
    rdfs:label "Glossy Textures" ;
    rdfs:comment "Overly perfect, shiny textures with no natural variation." ;
    :confidence 0.7 ;
    :appliesTo :Image .

:WarpedBackgrounds a :SlopSignal ;
    rdfs:label "Warped Backgrounds" ;
    rdfs:comment "Distorted backgrounds, unclean transitions in generated images." ;
    :confidence 0.8 ;
    :appliesTo :Image .

:MassProductionPattern a :SlopSignal ;
    rdfs:label "Mass Production Pattern" ;
    rdfs:comment "Same template/structure repeated across hundreds of content pieces." ;
    :confidence 0.85 ;
    :appliesTo :Text, :Image, :Video .

:NoAuthorIdentity a :SlopSignal ;
    rdfs:label "No Author Identity" ;
    rdfs:comment "Fake authors with AI-generated headshots and no publishing history." ;
    :confidence 0.8 ;
    :appliesTo :Text .

:CrossLingualArtifacts a :SlopSignal ;
    rdfs:label "Cross-Lingual Artifacts" ;
    rdfs:comment "Hindi or other language patterns in English output, indicating cross-lingual prompting." ;
    :confidence 0.7 ;
    :appliesTo :Text .

# --- Ecosystem Actors ---

:SlopFarmer a :SlopActor ;
    rdfs:label "Slop Farmer" ;
    rdfs:comment "Individual or firm that mass-produces AI slop for monetization. Often in developing countries (India, Kenya, Philippines). Cross-lingual prompts lead to absurd outputs." ;
    :produces :GenericSlop, :SEOSlop, :FakeProductImageSlop .

:SlopPlatform a owl:Class ;
    rdfs:label "Slop Platform" ;
    rdfs:comment "A digital platform whose incentive structure amplifies slop." .

:Facebook a :SlopPlatform ;
    rdfs:label "Facebook" ;
    rdfs:comment "Primary victim through older demographics (24% users over 55). Algorithm rewards engagement regardless of quality." .

:YouTube a :SlopPlatform ;
    rdfs:label "YouTube" ;
    rdfs:comment "278 AI channels with 63 billion views/year. YouTube Kids: 40% AI slop." .

:TikTok a :SlopPlatform ;
    rdfs:label "TikTok" ;
    rdfs:comment "AI video slop (Cat Soap Operas, Fruit Love Island). For You Page favors novelty." .

:Pinterest a :SlopPlatform ;
    rdfs:label "Pinterest" ;
    rdfs:comment "Aspirational AI slop (fake plants, fake recipes). 8.6M views for individual slop accounts." .

:GoogleSearch a :SlopPlatform ;
    rdfs:label "Google Search" ;
    rdfs:comment "AI Overviews amplify slop. SEO slop ranks through volume." .

:Spotify a :SlopPlatform ;
    rdfs:label "Spotify" ;
    rdfs:comment "Fake artists with millions of listeners. Royalty multiplication through volume." .

# --- Dynamics ---

:SlopAlgorithmFeedback a owl:Class ;
    rdfs:label "Slop-Algorithm Feedback Loop" ;
    rdfs:comment "Slop generates engagement → algorithm amplifies → more slop produced → positive feedback loop." .

:Enshittification a owl:Class ;
    rdfs:label "Enshittification" ;
    rdfs:comment "Progressive degradation of platform quality as slop displaces authentic human content." .

:SlopVsValuableAI a owl:Class ;
    rdfs:label "Slop vs. Valuable AI Distinction" ;
    rdfs:comment "Not all AI content is slop. The distinction lies in: Human Oversight, Effort, and Utility." .

:ArmsRace a owl:Class ;
    rdfs:label "Detection Arms Race" ;
    rdfs:comment "Better generators evade detection, better detection catches generators — cat-and-mouse dynamic." .

# --- New Countermeasures ---

:KagiSlopStop a :Countermeasure ;
    rdfs:label "Kagi SlopStop" ;
    rdfs:comment "Community tool for filtering AI slop from search results." .

:AlgorithmAdjustment a :Countermeasure ;
    rdfs:label "Algorithm Adjustment" ;
    rdfs:comment "Platforms adjusting algorithms to prioritize quality signals over pure engagement metrics." .

:DisclosurePolicies a :Countermeasure ;
    rdfs:label "Disclosure Policies" ;
    rdfs:comment "Regulatory requirements for AI content disclosure and labeling." .

# ============================================================================
# ROUND 4 ADDITIONS: Risk Profile, Retrieval Collapse, Agent Risk Levels
# ============================================================================

# --- Core Paradigm: Slopness as Risk Profile ---

:SlopnessScore a owl:Class ;
    rdfs:label "Slopness Score" ;
    rdfs:comment "AI Slop is not a binary media type but a risk profile. Slopness arises from the combination of synthetic generation, low human care, mass scaling, manipulative distribution, weak provenance, and quality deficiencies." .

:SlopnessDimension a owl:Class ;
    rdfs:label "Slopness Dimension" ;
    rdfs:comment "One of six axes along which slopness is measured: Generierung, Sorgfalt, Skalierung, Distribution, Provenienz, Qualität." .

# --- Agent Risk Levels ---

:AgentRiskLevel a owl:Class ;
    rdfs:label "Agent Risk Level" ;
    rdfs:comment "Classification of content risk for agent consumption. Determines whether content should be used in RAG/Memory systems." .

:CleanRisk a :AgentRiskLevel ;
    rdfs:label "🟢 Clean" ;
    rdfs:comment "Menschlich, geprüft, mit Quellen. Normal verwenden." .

:AIAssistedRisk a :AgentRiskLevel ;
    rdfs:label "🟡 AI-Assisted" ;
    rdfs:comment "AI-generiert, aber human-edited, nützlich. Mit Quellenangabe verwenden." .

:SuspiciousRisk a :AgentRiskLevel ;
    rdfs:label "🟠 Suspicious" ;
    rdfs:comment "AI-generiert, keine Quellen, generisch. Verifizieren vor Verwendung." .

:SlopRisk a :AgentRiskLevel ;
    rdfs:label "🔴 Slop" ;
    rdfs:comment "AI-generiert, substanzlos, massenhaft. NICHT in RAG/Memory aufnehmen." .

:MaliciousRisk a :AgentRiskLevel ;
    rdfs:label "⚫ Malicious" ;
    rdfs:comment "Slop + Absicht (Disinfo, Slopsquatting). Blockieren + Warnen." .

# --- Retrieval Collapse ---

:RetrievalCollapse a owl:Class ;
    rdfs:label "Retrieval Collapse" ;
    rdfs:comment "AI slop contaminates RAG-, Search- and Memory-systems. Two stages: Source dominance → Pipeline contamination. 67% pool contamination leads to 80%+ exposure contamination." .

:SourceDominance a owl:Class ;
    rdfs:subClassOf :RetrievalCollapse ;
    rdfs:label "Stage 1: Source Dominance" ;
    rdfs:comment "AI-generated content dominates search results, reducing source diversity." .

:PipelineContamination a owl:Class ;
    rdfs:subClassOf :RetrievalCollapse ;
    rdfs:label "Stage 2: Pipeline Contamination" ;
    rdfs:comment "Low-quality/adversarial content enters retrieval pipelines, causing agents to answer with slop." .

# --- Slop vs Spam ---

:SlopSpamDistinction a owl:Class ;
    rdfs:label "Slop vs. Spam Distinction" ;
    rdfs:comment "Spam = unwanted distribution. Slop = cheap generation + semantic superficiality + algorithmic scaling. Slop CAN be spam, but not all slop is spam, and not all spam is slop." .

:GoogleScaledContentAbuse a :SlopType ;
    rdfs:label "Scaled Content Abuse (Google)" ;
    rdfs:comment "Google's policy definition: many pages primarily for search manipulation, not user help. Includes: generative AI without added value, scraping, stitching, keyword pages without meaning." ;
    :hasMedium :Text ;
    :hasNormativeFraming :EpistemicPollution .

# --- Retrieval Defenses for Agents ---

:SourceDiversityCheck a :Countermeasure ;
    rdfs:label "Source Diversity Check" ;
    rdfs:comment "Require minimum 3+ different source domains in RAG results." .

:SlopScoreGate a :Countermeasure ;
    rdfs:label "Slop Score Gate" ;
    rdfs:comment "Only ingest sources with slop score < 0.4 into RAG/Memory." .

:ProvenanceFilter a :Countermeasure ;
    rdfs:label "Provenance Filter" ;
    rdfs:comment "Prefer human-verified sources with clear attribution." .

:CrossValidation a :Countermeasure ;
    rdfs:label "Cross-Validation" ;
    rdfs:comment "Verify facts against minimum 2 independent sources." .

:ContaminationDetection a :Countermeasure ;
    rdfs:label "Contamination Detection" ;
    rdfs:comment "Detect when search results are slop-dominated by checking information diversity." .

# ============================================================================
# ROUND 5: Formal Ontology Structure, Top-Level Classes, Intent Taxonomy
# ============================================================================

# --- Ontological Ground Decision ---

# WRONG: AIContent = Slop, HumanContent = NotSlop
# CORRECT: ContentItem has properties → derived classification
# AI_Slop ≈ ContentItem AND synthetic_or_ai_assisted AND low_quality AND low_effort AND mass_produced

# --- Properties ---

:hasGenerationMode a owl:ObjectProperty ;
    rdfs:domain :ContentItem ;
    rdfs:range :GenerationMode ;
    rdfs:comment "How the content was created." .

:hasHumanOversightLevel a owl:ObjectProperty ;
    rdfs:domain :ContentItem ;
    rdfs:range :OversightLevel ;
    rdfs:comment "Degree of human review before publication." .

:hasQualityProfile a owl:ObjectProperty ;
    rdfs:domain :ContentItem ;
    rdfs:range :QualityProfile ;
    rdfs:comment "Measured quality dimensions." .

:hasDistributionPattern a owl:ObjectProperty ;
    rdfs:domain :ContentItem ;
    rdfs:range :DistributionPattern ;
    rdfs:comment "How the content is distributed." .

:hasIntent a owl:ObjectProperty ;
    rdfs:domain :ContentItem ;
    rdfs:range :Intent ;
    rdfs:comment "Purpose behind content creation." .

:hasProvenanceStatus a owl:ObjectProperty ;
    rdfs:domain :ContentItem ;
    rdfs:range :ProvenanceStatus ;
    rdfs:comment "Verifiability of content origin." .

:hasRiskProfile a owl:ObjectProperty ;
    rdfs:domain :ContentItem ;
    rdfs:range :RiskLevel ;
    rdfs:comment "Risk classification for agent consumption." .

:hasSlopScore a owl:DatatypeProperty ;
    rdfs:domain :ContentItem ;
    rdfs:range xsd:float ;
    rdfs:comment "Derived slop score (0.0 = clean, 1.0 = maximum slop)." .

# --- Generation Modes ---

:GenerationMode a owl:Class ;
    rdfs:label "Generation Mode" ;
    rdfs:comment "How content was created." .

:Human a :GenerationMode ;
    rdfs:label "Human" ;
    rdfs:comment "Entirely human-created." .

:AI_Assisted a :GenerationMode ;
    rdfs:label "AI-Assisted" ;
    rdfs:comment "Human content with AI help (research, drafting, editing)." .

:Synthetic a :GenerationMode ;
    rdfs:label "Synthetic" ;
    rdfs:comment "Entirely or predominantly AI-generated." .

# --- Oversight Levels ---

:OversightLevel a owl:Class ;
    rdfs:label "Oversight Level" .

:FullOversight a :OversightLevel ;
    rdfs:label "Full" ;
    rdfs:comment "Thorough research + editing." .

:PartialOversight a :OversightLevel ;
    rdfs:label "Partial" ;
    rdfs:comment "Review but no deep verification." .

:MinimalOversight a :OversightLevel ;
    rdfs:label "Minimal" ;
    rdfs:comment "Glancing review only." .

:NoOversight a :OversightLevel ;
    rdfs:label "None" ;
    rdfs:comment "Published directly without review." .

# --- Distribution Patterns ---

:DistributionPattern a owl:Class ;
    rdfs:label "Distribution Pattern" .

:Organic a :DistributionPattern ;
    rdfs:label "Organic" ;
    rdfs:comment "Natural, targeted distribution." .

:SEOOptimized a :DistributionPattern ;
    rdfs:label "SEO-Optimized" ;
    rdfs:comment "Optimized for search engine ranking." .

:EngagementFarmed a :DistributionPattern ;
    rdfs:label "Engagement-Farmed" ;
    rdfs:comment "Designed to maximize engagement metrics." .

:Adversarial a :DistributionPattern ;
    rdfs:label "Adversarial" ;
    rdfs:comment "Deliberately placed to poison information systems." .

:PlatformAmplified a :DistributionPattern ;
    rdfs:label "Platform-Amplified" ;
    rdfs:comment "Algorithm amplifies due to engagement signals." .

# --- Provenance Status ---

:ProvenanceStatus a owl:Class ;
    rdfs:label "Provenance Status" .

:Verified a :ProvenanceStatus ;
    rdfs:label "Verified" ;
    rdfs:comment "Clear authorship, cited sources." .

:Unverified a :ProvenanceStatus ;
    rdfs:label "Unverified" ;
    rdfs:comment "No clear provenance." .

:FakeAuthor a :ProvenanceStatus ;
    rdfs:label "Fake Author" ;
    rdfs:comment "AI-generated headshot, no publishing history." .

:Spoofed a :ProvenanceStatus ;
    rdfs:label "Spoofed" ;
    rdfs:comment "Identity forged or impersonated." .

# --- Expanded Intent Taxonomy ---

:Intent a owl:Class ;
    rdfs:label "Intent" ;
    rdfs:comment "Purpose behind content creation." .

:AttentionFarming a :Intent ;
    rdfs:label "Attention Farming" ;
    rdfs:comment "Reichweite, Likes, Watchtime." .

:AdRevenueFarming a :Intent ;
    rdfs:label "Ad Revenue Farming" ;
    rdfs:comment "Monetarisierung über Ads." .

:RoyaltyDilution a :Intent ;
    rdfs:label "Royalty Dilution" ;
    rdfs:comment "Streaming-Royalties durch Massenmusik." .

:SearchManipulation a :Intent ;
    rdfs:label "Search Manipulation" ;
    rdfs:comment "SEO, GEO, Ranking-Manipulation." .

:RecommendationPoisoning a :Intent ;
    rdfs:label "Recommendation Poisoning" ;
    rdfs:comment "Inhalte so platzieren dass KI-Antwortsysteme sie bevorzugen. Google hat Spamregeln auf Manipulation generativer Suchsysteme erweitert." .

:AffiliateFunnel a :Intent ;
    rdfs:label "Affiliate Funnel" ;
    rdfs:comment "KI-Content als Traffic-Funnel." .

:CredentialInflation a :Intent ;
    rdfs:label "Credential Inflation" ;
    rdfs:comment "Paper, Zitate, Profile zur Reputationssteigerung." .

:Disinformation a :Intent ;
    rdfs:label "Disinformation" ;
    rdfs:comment "Absichtlich irreführender synthetischer Content." .

:CarelessSpeech a :Intent ;
    rdfs:label "Careless Speech" ;
    rdfs:comment "Nicht zwingend bösartig, aber ungeprüft, oberflächlich, irreführend." .

:Impersonation a :Intent ;
    rdfs:label "Impersonation" ;
    rdfs:comment "Stimme, Stil, Name, Marke oder Person wird imitiert." .

:PlaceholderPublishing a :Intent ;
    rdfs:label "Placeholder Publishing" ;
    rdfs:comment "Content wird veröffentlicht obwohl er nur Entwurf/Füllmaterial ist." .

# --- Expanded Media Types ---

:AcademicSlop a :SlopType ;
    rdfs:label "Academic Slop" ;
    rdfs:comment "AI-generated papers, preprints, reviews. Fake citations, superficial literature reviews, template structure. PARTICULARLY DANGEROUS — does not look cheap." ;
    :hasMedium :Text ;
    :detectedBy :CitationVerification , :SourceVerification ;
    :hasNormativeFraming :EpistemicPollution ;
    rdfs:comment "arXiv 2026: verschärfte Regeln gegen unvalidierte LLM-Inhalte. NeurIPS 2025: KI-halluzinierte Zitate nutzen Plausibilitätsheuristiken gleichzeitig aus." .

:LegalSlop a :SlopType ;
    rdfs:label "Legal Slop" ;
    rdfs:comment "AI-generated legal documents with invented precedents, false norms, unvalidated citations. PARTICULARLY DANGEROUS — looks professional." ;
    :hasMedium :Text ;
    :hasNormativeFraming :EpistemicPollution .

:WorkSlopFamily a :SlopType ;
    rdfs:label "Work Slop Family" ;
    rdfs:comment "Internal reports, presentations, memos. Looks professional, saves sender time, costs receiver time. Invisible Cost Shift." ;
    :hasMedium :Text ;
    :hasNormativeFraming :NonconsensualImposition .

:EngagementClickbaitSlop a :SlopType ;
    rdfs:label "Engagement/Clickbait Slop" ;
    rdfs:comment "Optimized for viral potential — motivational and emotional bait (Veteran Birthday Signs, Shrimp Jesus, cat soap operas)." ;
    :hasNormativeFraming :AttentionEconomyExploitation .

:SEOContentFarmSlop a :SlopType ;
    rdfs:label "SEO/Content Farm Slop" ;
    rdfs:comment "Keyword-stuffed pages produced for programmatic advertising revenue." ;
    :hasMedium :Text ;
    :hasNormativeFraming :EpistemicPollution .

:PropagandaDisinfoSlop a :SlopType ;
    rdfs:label "Propaganda/Disinfo Slop" ;
    rdfs:comment "Politically motivated AI content, including AI images and coordinated Spamouflage campaigns." ;
    :hasNormativeFraming :EpistemicPollution .

:MonetizationSlop a :SlopType ;
    rdfs:label "Monetization Slop (Slop Farmers)" ;
    rdfs:comment "Content produced for direct revenue: platform bonus programs, fake shops, affiliate farming." ;
    :hasNormativeFraming :EconomicFraud .

:SpamNoiseSlop a :SlopType ;
    rdfs:label "Spam/Noise Slop" ;
    rdfs:comment "Filler material with no discernible purpose beyond occupying a channel." ;
    :hasNormativeFraming :NonconsensualImposition .

# --- Root class and medium groupings ---
# :AISlop was used as the domain of five relationship properties without ever
# being declared, and the medium groupings existed only as group keys in
# ontology.json (review 2026-08).

:AISlop a owl:Class ;
    rdfs:label "AI Slop" ;
    rdfs:comment "Content whose generation is primarily AI, whose human care and verification are absent, and which is distributed unsolicited. The risk profile, not the generation mode." .

:TextSlop a owl:Class ;
    rdfs:subClassOf :AISlop ;
    rdfs:label "Text Slop" ;
    :hasMedium :Text .

:ImageSlop a owl:Class ;
    rdfs:subClassOf :AISlop ;
    rdfs:label "Image Slop" ;
    :hasMedium :Image .

:VideoSlop a owl:Class ;
    rdfs:subClassOf :AISlop ;
    rdfs:label "Video Slop" ;
    :hasMedium :Video .

:AudioSlop a owl:Class ;
    rdfs:subClassOf :AISlop ;
    rdfs:label "Audio Slop" ;
    :hasMedium :Audio .

:MusicSlop a owl:Class ;
    rdfs:subClassOf :AudioSlop ;
    rdfs:label "Music Slop" .

:CodeSlop a owl:Class ;
    rdfs:subClassOf :AISlop ;
    rdfs:label "Code Slop" ;
    :hasMedium :Code .

:MultimodalSlop a owl:Class ;
    rdfs:subClassOf :AISlop ;
    rdfs:label "Multimodal Slop" ;
    rdfs:comment "Slop combining several media, e.g. AI narration over AI video with AI-written captions." .

# --- Intent types ---

:RecommendationPoisoningSlop a :SlopType ;
    rdfs:label "Recommendation Poisoning Slop" ;
    rdfs:comment "AI content placed or replicated to distort recommendation, retrieval, or agent selection systems." ;
    :hasNormativeFraming :EpistemicPollution .

:ImpersonationSlop a :SlopType ;
    rdfs:label "Impersonation Slop" ;
    rdfs:comment "AI-generated content imitating a person, organization, artist, brand, or authoritative source without legitimate authorization or clarity." ;
    :hasNormativeFraming :EconomicFraud .

:PlaceholderPublishingSlop a :SlopType ;
    rdfs:label "Placeholder Publishing Slop" ;
    rdfs:comment "Draft-like or filler AI output published as finished content without sufficient review, evidence, or audience-specific purpose. Includes published 'As an AI language model' artifacts." ;
    :hasNormativeFraming :NonconsensualImposition .

# ============================================================================
# v1.0.0 ADDITIONS: 7Vs, Harms, Relationship Graph, Etymology, Analogues
# ============================================================================

# --- Necessary Conditions ---

:NecessaryCondition a owl:Class ;
    rdfs:label "Necessary Condition for AI Slop" ;
    rdfs:comment "All three must be met for content to qualify as AI Slop." .

:AIPrimarySource a :NecessaryCondition ;
    rdfs:label "1. AI Primary Source" ;
    rdfs:comment "Generative KI ist primäre Quelle des Inhalts." .

:LacksHumanCare a :NecessaryCondition ;
    rdfs:label "2. Lacks Human Care" ;
    rdfs:comment "Es fehlt menschliche Sorgfalt, Kuration oder Verifikation." .

:UnsolicitedPush a :NecessaryCondition ;
    rdfs:label "3. Unsolicited Push Distribution" ;
    rdfs:comment "Der Inhalt wird unverlangt publiziert/distribuiert (Push statt Pull)." .

# --- 7Vs Systemic Dimensions (Madsen & Puyt 2025) ---

:SystemicDimension7V a owl:Class ;
    rdfs:label "7V Systemic Dimension" ;
    rdfs:comment "System-level properties of the slop ecology (Madsen & Puyt 2025). Complements per-item quality taxonomy." ;
    dc:source "Madsen & Puyt 2025, SSRN 5558018" .

:Volume7V a :SystemicDimension7V ;
    rdfs:label "Volume" ;
    rdfs:comment "Produktionsskala. Metric: Items pro Tag/Plattform." .

:Velocity7V a :SystemicDimension7V ;
    rdfs:label "Velocity" ;
    rdfs:comment "Generierungs- und Zirkulationsgeschwindigkeit. Metric: Latenz Prompt → Publish." .

:Variety7V a :SystemicDimension7V ;
    rdfs:label "Variety" ;
    rdfs:comment "Spannweite an Formen/Genres. Metric: Modalitäts-Coverage." .

:Value7V a :SystemicDimension7V ;
    rdfs:label "Value" ;
    rdfs:comment "Erosion kulturellen/epistemischen Werts. Metric: Trust-Surveys; Citation-Quality." .

:Verification7V a :SystemicDimension7V ;
    rdfs:label "Verification" ;
    rdfs:comment "Wahrheits- und Vertrauensproblem. Metric: Fact-Check-Rate." .

:Visibility7V a :SystemicDimension7V ;
    rdfs:label "Visibility" ;
    rdfs:comment "Algorithmische Verstärkung. Metric: Recommendation-Anteil." .

:Virality7V a :SystemicDimension7V ;
    rdfs:label "Virality" ;
    rdfs:comment "Memetische Diffusion. Metric: Reproduktionsrate R." .

# --- 12 Harm Types ---

:HarmType a owl:Class ;
    rdfs:label "Harm Type" ;
    rdfs:comment "A specific negative consequence of AI slop, with mechanism and evidence." .

:ModelCollapseHarm a :HarmType ;
    rdfs:label "Model Collapse" ;
    rdfs:comment "Recursive training on AI output → loss of distribution tails, gibberish convergence." ;
    dc:source "Shumailov et al. 2024, Nature 631" .

:EpistemicPollutionHarm a :HarmType ;
    rdfs:label "Epistemic Pollution" ;
    rdfs:comment "Polluted information ecology, LLMs cite UAINs as sources." ;
    dc:source "NewsGuard Aug 2025; EDMO" .

:MisinformationHarm a :HarmType ;
    rdfs:label "Mis/Disinformation" ;
    rdfs:comment "State or commercially driven false-claim operations." ;
    dc:source "US Treasury Dec 2024; Storm-1516; Freedom House 2025" .

:TrustErosionHarm a :HarmType ;
    rdfs:label "Trust Erosion" ;
    rdfs:comment "Liar's dividend; difficulty distinguishing real from fake." ;
    dc:source "Koebler 404 Media" .

:WorkplaceProductivityHarm a :HarmType ;
    rdfs:label "Workplace Productivity Loss" ;
    rdfs:comment "Workslop offloads cognitive load to receivers; 40% employees affected; ~1h56m rework per instance." ;
    dc:source "Niederhoffer et al. HBR 2025" .

:CreatorSqueezeHarm a :HarmType ;
    rdfs:label "Creator Squeeze" ;
    rdfs:comment "Algorithms don't distinguish original from fake bulk → originals displaced." ;
    dc:source "Scientific American" .

:ChildrenHarm a :HarmType ;
    rdfs:label "Harm to Children" ;
    rdfs:comment "~40% YouTube Kids recommendations are slop; false info, dangerous behavior." ;
    dc:source "NYT Mar 2026; The 74; Mother Jones" .

:AdFraudHarm a :HarmType ;
    rdfs:label "Ad Fraud / Brand Safety" ;
    rdfs:comment "141 blue-chip brands unknowingly advertising on content farms." ;
    dc:source "NewsGuard/AdWeek 2026" .

:CognitiveLoadHarm a :HarmType ;
    rdfs:label "Cognitive Load" ;
    rdfs:comment "Constant 'Is this real?' verification exhausts attention." ;
    dc:source "Koebler 'Your AI Use Is Breaking My Brain' 2026" .

:EnvironmentalCostHarm a :HarmType ;
    rdfs:label "Environmental Cost" ;
    rdfs:comment "Energy and water consumption of generative models." ;
    dc:source "Crawford 'Eating the Future'" .

:DemocracyRiskHarm a :HarmType ;
    rdfs:label "Democracy Risk" ;
    rdfs:comment "Election manipulation, deepfake endorsements." ;
    dc:source "Wikipedia; Freedom on the Net 2025" .

:RoyaltyFraudHarm a :HarmType ;
    rdfs:label "Royalty Fraud" ;
    rdfs:comment "AI tracks for streaming royalty manipulation." ;
    dc:source "DOJ; Wikipedia" .

# --- Historical Analogues ---

:HistoricalAnalogue a owl:Class ;
    rdfs:label "Historical Analogue" ;
    rdfs:comment "A historical precedent for mass-produced, economically motivated, aesthetically/epistemically deficient output." .

:GrubStreet a :HistoricalAnalogue ;
    rdfs:label "Grub Street" ;
    rdfs:comment "London, 1700s. Cheap printed works, mass-produced, economically motivated." .

:Kitsch a :HistoricalAnalogue ;
    rdfs:label "Kitsch" ;
    rdfs:comment "Munich, 1860s. Derogatory term for mass-produced art." .

:PulpFiction a :HistoricalAnalogue ;
    rdfs:label "Pulp Fiction" ;
    rdfs:comment "1900s. Cheaply produced magazine novels." .

:Churnalism a :HistoricalAnalogue ;
    rdfs:label "Churnalism" ;
    rdfs:comment "2000s. Rewritten press releases as journalism." .

# --- Specializations ---

:Slom a :SlopType ;
    rdfs:label "Slom" ;
    rdfs:comment "AI-Spam-Subset (Willison). Overlap between slop and spam." .

:Brainrot a :SlopType ;
    rdfs:label "Brainrot" ;
    rdfs:comment "Low-attention reward content. Italian brainrot, Fruit Love Island." ;
    :hasMedium :Video .

:Necromemetics a :SlopType ;
    rdfs:label "Necromemetics" ;
    rdfs:comment "Post-violence meme economy (Koebler)." .

:AIWorkslop a :SlopType ;
    rdfs:label "AI Workslop" ;
    rdfs:comment "AI-generated workplace content that saves sender time but costs receiver time. 40% of employees affected; ~1h56m rework per instance." ;
    dc:source "Niederhoffer et al. HBR 2025" ;
    :hasNormativeFraming :NonconsensualImposition .

# --- Relationship Properties ---

:isAnalogousTo a owl:ObjectProperty ;
    rdfs:domain :AISlop ;
    rdfs:range :HistoricalAnalogue .

:isCausedBy a owl:ObjectProperty ;
    rdfs:domain :AISlop ;
    rdfs:range :AttentionEconomy .

:coOccursWith a owl:ObjectProperty ;
    rdfs:domain :AISlop ;
    rdfs:range :ModelCollapse .

:enables a owl:ObjectProperty ;
    rdfs:domain :AISlop ;
    rdfs:range :AIWorkslop .

:hasHarm a owl:ObjectProperty ;
    rdfs:domain :AISlop ;
    rdfs:range :HarmType .

# --- Causes ---

:AttentionEconomy a owl:Class ;
    rdfs:label "Attention Economy" ;
    rdfs:comment "Platform incentive structure that rewards engagement regardless of quality." .

:ZeroMarginalCostGeneration a owl:Class ;
    rdfs:label "Zero Marginal Cost Generation" ;
    rdfs:comment "AI reduces content production cost to near zero." .

:LowEntryBarrier a owl:Class ;
    rdfs:label "Low Entry Barrier" ;
    rdfs:comment "Prompt-only workflow requires no skill or investment." .
